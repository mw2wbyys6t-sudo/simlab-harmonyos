  /** 直流稳压电源:整流、滤波与纹波、稳压器 */
  static power(): KnowledgePoint[] {
    const out: KnowledgePoint[] = [];
    out.push(k('kn-ele-sr-014', KnowledgeElectronicsSenior.POWER, '整流',
      '整流输出的平均值按交流有效值算而不是按峰值',
      '单相半波整流的输出直流平均值 U_o ≈ 0.45U_2,全波与桥式 U_o ≈ 0.9U_2,式中的 U_2 是变压器副边电压的有效值而不是峰值,也不是整流管的压降;所以副边 10 V 交流经桥式整流后空载平均约 9 V,而电压峰值高达约 14 V,拿 9 V 这个平均值去选滤波电容的耐压就会选小,选耐压必须按峰值留余量',
      ['半波 0.45U_2', '桥式 0.9U_2', '峰值 = √2 U_2'], KnowledgeLevel.APPLY, []));
    out.push(k('kn-ele-sr-015', KnowledgeElectronicsSenior.POWER, '整流',
      '桥式整流的导通配对与每管的电流、反压',
      '桥式四只二极管按两两共阴、两两共阳成对轮流导通,正半周两只通、负半周另两只通,任一只接反就会在半个周期内把变压器副边直接短路而烧管;每只管子流过的平均电流只是负载电流的一半,承受的最高反向电压为 √2U_2,所以按输出电流的两倍选管属于选大了,而按输出电压的数值选管也不成立,要看的是它截止时两端可能加到多高',
