import { KnowledgePoint, KnowledgeLevel, makeKnowledge } from './KnowledgeTypes';
import { MapSubject, SchoolStage, UNVERIFIED_PREFIX } from './CurriculumTypes';

/**
 * 高中电子学知识点。
 *
 * **这张表填的是「电子学·高中」这个原本 0 条的格子。** 内容框架按「电子控制技术」
 * (选择性必修,浙江教育版与江苏教育版共有的那套内容)的通行编排整理:常用元器件与放大、
 * 直流稳压电源、运算放大器、数字电路与脉冲电路、传感器与控制系统、电路安装与调试。
 * course 因此按这六个内容块命名,而不是按册次 —— 这门课在不同版本里分册口径不一致,
 * 按册次排反而会给出一个假的精确性。
 *
 * **与物理表的分工是刻意划开的。** KnowledgePhysicsSenior 那 53 条已经收了电容与平行板
 * 电容器、带电粒子在电场中的运动、电阻定律、电动势与路端电压、焦耳定律与非纯电阻、
 * 磁感应强度与洛伦兹力、楞次定律与法拉第定律、交变电流有效值与变压器,并且它自己在文件头
 * 就声明「有意没写传感器」。这些**电学物理规律**本表一律不重写;本表讲的是
 * **器件特性、电路组态、逻辑与控制系统** —— 同一个 PN 结,物理表不问,本表问它导通后压降
 * 多少、反偏时能承受多大电压、接成三种组态各有哪一样放大。
 *
 * **一条 = 能被单独提问、单独判对错的最小单元。** 上一轮的教训是给条数设上限,代理就把
 * 几个各自能单独提问的考点合并去够上限,所以这里按「宁多勿合并」办:三种组态拆成共射
 * (kn-ele-sr-004)、共集(005)、共基(006)与「按需求选组态」(007)四条;失真拆成
 * 「为什么必须有静态工作点」(009)与「削哪半周对应哪种失真」(010)两条;555 拆成
 * 门限来源(039)、三种接法(040)、多谐占空比(041)、单稳脉宽(042)四条。
 *
 * **内容边界的诚实说明**:器件参数与判据(硅管 0.7 V、桥式整流 U_o ≈ 0.9U_2、
 * 电容滤波后二极管反压接近 2√2U_2、555 门限取 2/3V_CC 与 1/3V_CC、单稳脉宽 ≈ 1.1RC)
 * 属数据手册级事实与电路分析的通行结论,本身可判对错;而**覆盖面与排列顺序**只是按上述
 * 课程框架的通行编排整理,**未核对纸质教材目录与《课程标准》原文**,故整表 `source`
 * 带 `未核实:` 前缀,不对外声称已核实。
 *
 * 前置只引用**本文件内序号更小的 id**(001–049):跨文件引用会被
 * MapValidator.validateKnowledge 判成悬挂引用,两张表各自成链,不做跨表跳转。
 */
const ELE: MapSubject = MapSubject.ELECTRONICS;
const SR: SchoolStage = SchoolStage.SENIOR;
const COVERAGE: string = UNVERIFIED_PREFIX + '按「电子控制技术」选择性必修的通行内容框架编排覆盖面与顺序,未核对教材目录';

function k(id: string, course: string, chapter: string, title: string, statement: string,
  symbols: string[], level: KnowledgeLevel, prereq: string[]): KnowledgePoint {
  return makeKnowledge(id, ELE, SR, course, chapter, title, statement, symbols,
    level, prereq, COVERAGE);
}

