import {
  ExperimentEntry, Feasibility, makeEntry, MapSubject, SchoolStage, UNVERIFIED_PREFIX
} from './CurriculumTypes';

/**
 * 普通生物学实验目录:大学「普通生物学(实验)」课里的**实验项目清单**,
 * 不是知识点(知识点在 KnowledgeBiology,两张表分工不同)。
 *
 * **第一轮全部未核实。**本项目 2026-10-07 试过的来源里,百度百科《普通生物学实验》词条返回
 * 403、院校实验中心的项目页一个都没抓到正文,所以本文件每条 `source` 都以 `UNVERIFIED_PREFIX`
 * 开头,`verified` 由前缀推出为一律为假。这份清单的覆盖面与顺序来自陈阅增《普通生物学》
 * 配套实验的通行安排(细胞—形态解剖—生理—分类与生态四段),它能用来排「这门课该做哪些实验」的序,
 * **不能当作某一校的实际开课目录引用**。term 与 minutes 同理,是按多数院校排法给的粗位置
 * (minutes 一律给 0,因为没有来源给出过课时)。等 P2 补到具体页面或教材版次后**逐条升级**,
 * 不整表翻牌。
 *
 * 与 UniversityPhysics 同样的分工:principle / apparatus / dataHandling 三栏是编写者按该实验的
 * 标准做法概括的,不是从任何清单逐字抄的。
 *
 * 可行性四档的判据写在这里,否则这栏就成了心情 —— 判的是**引擎能力**,不是场景库写好了几条:
 * 现有渲染只有回转体玻璃器皿(量筒/烧杯/试管/漏斗/蒸发皿)、2D 物理求解(斜面、弹簧振子、电路)
 * 与化学实验台(药品柜 + 容器 + 酒精灯)。生物这边**显微视野、三维结构、组织切片、活体观察
 * 都没有渲染器**。因此:
 * - **RUNNABLE:本文件一条都没有。**上面那三类渲染器承载不了任何一个生物学实验的教学目的,
 *   连「用量筒取水样」这种表面重合也不算 —— 那些实验要读的是视野里的东西或手上做出来的东西。
 * - **NEEDS_RENDERER**:卡在画法上 —— 显微视野与分期、切片与组织、层析谱与色带、计数板视野、
 *   凝集团块。补了画法再叠一层渗透/分裂/光合的模型才有意义,所以这一档记的是**第一道坎**。
 * - **NEEDS_REAL_GEARS**:教学目的本身就长在实物与手法上 —— 装片制作与调焦、解离与压片、
 *   解剖与标本、涂片染色倒平板、检索表与腊叶标本。这些做成仿真就是假实验,老实标出来,
 *   **不排进工期**。
 * - **NEEDS_MODEL**:数据是能算的量,缺的是模型而不是画法 —— 遗传统计与卡方、核型配对、
 *   酶活与光合呼吸的速率模型、种群与群落的统计。这类周期长、靠计数与统计,
 *   也正是最适合仿真的一段,所以本文件的 16 条 NEEDS_MODEL 全在遗传那一批、生理段与生态段
 *   (形态解剖段一条都没有 —— 那一段的坎不在算,在手)。
 * 两处按主导环节判的,写明了免得看着像标错:第 001 条(显微镜使用 + 测微尺标定)标 REAL_GEARS
 * 而不是 RENDERER,因为它的评分点在亲手制样、对光与调焦;第 032 条(脊蛙反射弧)标 REAL_GEARS,
 * 因为毁脑制备与损毁环节是真实操作,只有其中的浓度—反射时关系是可建模的。
 * 第 023 条(纸层析)与第 041 条(计数板)虽也含统计,但第一道坎是色带与计数室视野的画法,
 * 记在 RENDERER 档。
 *
 * 序号 bio-u-001 至 bio-u-041 连续分配、四段为 001–012 / 013–022 / 023–033 / 034–041,
 * 段间不留空号(与 chem 表的做法不同,以后要插项请直接追加到段尾)。
 */
const BIO: MapSubject = MapSubject.BIOLOGY;
const U: SchoolStage = SchoolStage.UNIVERSITY;
const SRC_CELL: string = UNVERIFIED_PREFIX + '通用教材通行项目,未核对本校开课清单';
const SRC_MORPH: string = UNVERIFIED_PREFIX + '通用教材通行项目(动植物形态与解剖),未核对本校开课清单';
const SRC_PHYS: string = UNVERIFIED_PREFIX + '通用教材通行项目(生理与生化),未核对本校开课清单';
const SRC_ECOL: string = UNVERIFIED_PREFIX + '通用教材通行项目(微生物、分类与生态),未核对本校开课清单';

function p(id: string, course: string, term: string, title: string, apparatus: string[],
  principle: string, dataHandling: string, knowledge: string[],
  feasibility: Feasibility, source: string): ExperimentEntry {
  return makeEntry(id, BIO, U, course, term, 0, title, apparatus, principle,
    dataHandling, knowledge, feasibility, source);
}

