import { KnowledgePoint, KnowledgeLevel, makeKnowledge } from './KnowledgeTypes';
import { MapSubject, SchoolStage, UNVERIFIED_PREFIX } from './CurriculumTypes';

/**
 * 高中生物知识点(人教版 2019)。
 *
 * **`source` 只为覆盖面与顺序作证,不为生物学内容作证。** 一条 statement 是否成立靠专业判断
 * 和离线断言核,不靠引用;这里要说清的是「高中生物确实教这些、按这个册次与章序排」。
 *
 * 册次与章名照人教版(2019)五册的目录取:必修一 分子与细胞 = 组成细胞的分子 /
 * 细胞的基本结构 / 细胞的物质输入和输出 / 细胞的能量供应和利用 / 细胞的生命历程,
 * 必修二 遗传与进化 = 遗传因子的发现 / 基因和染色体的关系 / 基因的本质 / 基因的表达 /
 * 基因突变及其他变异 / 生物的进化,选择性必修一 稳态与调节 = 内环境与稳态 / 神经调节 /
 * 体液调节 / 免疫调节 / 植物生命活动的调节,选择性必修二 生物与环境 = 种群和群落 /
 * 种群的数量变化 / 生态系统及其稳定性,选择性必修三 生物技术与工程 = 发酵工程 /
 * 基因工程 / 细胞工程。
 * 必修一、必修二、选必三的章名参考了网上的人教版教材目录页,**没有核对过教材纸质目录**,
 * 选必一与选必二的章名按课标内容大项表述而非逐条核对的节标题,所以全部带 `未核实:` 前缀 ——
 * 二手清单不足以让一条数据对外声称已核实。
 *
 * 两处顺序与教材不同,是为了让前置只能指向更小的序号:选必三按 发酵→基因→细胞 排,
 * 因为基因工程那条要接必修二的 DNA、细胞工程那条要接必修一的细胞全能性;
 * 必修二把「基因和染色体的关系」的减数分裂排在遗传规律之前(015 早于 016),
 * 因为两个定律的实质都以同源染色体分离为机制,倒过来挂前置就成了向后引用。
 *
 * 共 40 条,粒度刻意做到「每节一条起」:必修一 14、必修二 11、选必一 6、选必二 5、选必三 4。
 * 为此做了几处合并而不是遗漏:「细胞中的元素和化合物」与「细胞中的无机物」合成 001,
 * 糖类脂质与蛋白质的鉴定反应合成 003,「细胞的增殖」并入 013 的染色体与 DNA 数目变化,
 * 「基因突变和基因重组」与「染色体变异」的比较判据合成 024,「能量流动」与「物质循环」
 * 的对比合成 035,「信息传递」与「生态系统的稳定性」合成 036。
 *
 * 有意没写的:单克隆抗体的制备与两次筛选、胚胎工程(体内受精、早期胚胎培养与胚胎移植)、
 * 选必三第四章生物技术的安全性与伦理问题(多是讨论题而不是可判对错的命题)、
 * 人类遗传病的类型与监测预防(偏政策法规)、DNA 双螺旋结构模型的建构史、
 * 「探索生长素类似物促进插条生根的最适浓度」的预实验与「培养液中酵母菌种群数量的变化」
 * 的血细胞计数板操作(都是操作技能,依赖实物,判不了对错)。
 *
 * 一条原则:前置只引用**本文件内序号更小的 id**(001–040)。初中那张 `kn-bio-jr-*` 与大学那张
 * `kn-bio-u-*` 讲的是同一件事的更浅或更深版本,但跨文件引用会被 MapValidator 判成悬挂引用 ——
 * 三张表各自成链,不做跨表跳转。
 */
const BIO: MapSubject = MapSubject.BIOLOGY;
const SR: SchoolStage = SchoolStage.SENIOR;
const COVERAGE: string = UNVERIFIED_PREFIX + '章名与顺序按人教版高中生物教材(2019)编排,必修一、必修二、选必三参考网络教材目录页,选必一与选必二按课标内容大项表述,未核对教材纸质目录与课标原文';

function k(id: string, course: string, chapter: string, title: string, statement: string,
  symbols: string[], level: KnowledgeLevel, prereq: string[]): KnowledgePoint {
  return makeKnowledge(id, BIO, SR, course, chapter, title, statement, symbols,
    level, prereq, COVERAGE);
}

