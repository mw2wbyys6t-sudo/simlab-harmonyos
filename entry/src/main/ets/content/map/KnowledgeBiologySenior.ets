    out.push(k('kn-bio-sr-048', KnowledgeBiologySenior.HOMEOSTASIS, '内环境与稳态', '血浆、组织液与淋巴的成分差别及不属于内环境的四类物质',
      '血浆、组织液与淋巴的成分相近但并不相同:血浆中蛋白质含量明显高于组织液与淋巴,因为组织液是血浆透过毛细血管壁滤过形成的、大分子血浆蛋白一般不能滤过;淋巴由组织液渗入毛细淋巴管而成,成分更接近组织液且其中淋巴细胞与吞噬细胞较多。判断某物质属不属于内环境只看它是否在细胞外液中:血红蛋白在红细胞内、与细胞呼吸有关的酶在细胞内、消化酶被分泌到消化道腔、细胞膜上的载体蛋白属膜的结构,这四类都不属于内环境成分;而葡萄糖、氨基酸、血浆蛋白、抗体、激素、尿素、O2 与 CO2 都是内环境的组成。呼吸道、消化道、膀胱等与外界相通的腔道中的液体属于外界环境而不是内环境,汗液、尿液与精液同样不属于内环境',
      ['蛋白质含量:血浆 > 组织液、淋巴', '非内环境四类:血红蛋白、呼吸酶、消化酶、载体蛋白'], KnowledgeLevel.RECALL,
      ['kn-bio-sr-026']));
    out.push(k('kn-bio-sr-049', KnowledgeBiologySenior.HOMEOSTASIS, '内环境与稳态', 'pH 稳态靠缓冲对与组织水肿的五种成因',
      '血浆 pH 稳定在 7.35~7.45 靠的是 H2CO3/NaHCO3、NaH2PO4/Na2HPO4 等缓冲物质的中和作用,而不是只靠肺排出 CO2 或肾排酸:剧烈运动产生的乳酸进入血液后与 NaHCO3 反应生成乳酸钠和 H2CO3,H2CO3 分解为 CO2 和水、CO2 经肺排出,故 pH 不会明显下降;只有产酸量超出缓冲能力或肺、肾功能障碍时才会出现酸中毒。组织水肿是组织液增多,五种成因都归结于血浆与组织液之间的渗透压关系:血浆蛋白减少(营养不良或肾小球肾炎使蛋白随尿流失)、毛细淋巴管阻塞使淋巴回流受阻、毛细血管通透性升高让血浆蛋白进入组织液、局部代谢产物增多使组织液渗透压升高而吸水、一次吃盐过多使细胞外液渗透压升高。可见水肿不等于血浆成分增多,多数情况下反而是血浆渗透压下降所致',
