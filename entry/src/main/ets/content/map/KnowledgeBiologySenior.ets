  /** 必修二:遗传规律、遗传的分子基础、变异与进化 */
  static geneticsAndEvolution(): KnowledgePoint[] {
    const out: KnowledgePoint[] = [];
    out.push(k('kn-bio-sr-015', KnowledgeBiologySenior.HEREDITY_EVOLUTION, '基因和染色体的关系', '有丝分裂与减数分裂的染色体行为区别',
