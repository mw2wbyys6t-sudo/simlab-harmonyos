      ['kn-bio-sr-026', 'kn-bio-sr-048']));
    out.push(k('kn-bio-sr-050', KnowledgeBiologySenior.HOMEOSTASIS, '内环境与稳态', '稳态的实质、调节机制与稳态失调的原因',
      '内环境稳态是正常机体通过调节使各器官、系统协调活动,共同维持内环境的化学成分与理化性质相对稳定的状态,其实质是相对稳定而不是恒定不变——代谢每时每刻都在产生酸性物质并消耗 O2,所以各项指标都在一定范围内波动;把稳态说成 pH、温度「保持不变」是错的。目前公认的调节机制是神经—体液—免疫调节网络,其中免疫系统通过清除病原体与衰老、损伤的细胞参与稳态维持,把稳态只归因于神经调节或认为只靠某一个器官(如肾)完成都不对。人体维持稳态的调节能力有一定限度,当外界环境变化过于剧烈或自身调节功能障碍时稳态就会遭到破坏,细胞代谢随之紊乱,因为酶促反应需要适宜的温度、pH 与渗透压。内环境是细胞与外界环境进行物质交换的媒介,单细胞生物直接与外界交换物质、没有内环境这一概念',
      ['调节机制:神经—体液—免疫调节网络', '稳态:相对稳定而非恒定不变'], KnowledgeLevel.RECALL,
      ['kn-bio-sr-026', 'kn-bio-sr-048']));
    out.push(k('kn-bio-sr-051', KnowledgeBiologySenior.HOMEOSTASIS, '体液调节', '促胰液素的发现:沃泰默与斯他林、贝利斯实验设计的差别',
      '沃泰默把稀盐酸注入狗的上段小肠肠腔引起胰腺分泌胰液,而把稀盐酸直接注入血液则不引起;他切断通向小肠的神经、只保留血管后再注入稀盐酸,胰腺仍然分泌,却仍认定这属于神经反射,只是没能跳出「反射」这一解释框架。斯他林与贝利斯作出的假设是盐酸使小肠黏膜产生了某种化学物质,随血液到达胰腺引起分泌;他们把小肠黏膜与稀盐酸一起研磨制成提取液、注入同一条狗的静脉,果然引起胰液分泌,由此发现了促胰液素,它是人们发现的第一种激素,其调节方式属体液调节而不是神经调节。两组的差别不在实验材料而在假设与对照:切除神经只排除了神经的参与,还必须证明黏膜提取物本身能经血液起作用,而研磨是为了破坏细胞、让该物质释放出来',
      ['切除神经后盐酸仍引起胰液分泌', '促胰液素:第一种激素,由小肠黏膜产生、靶器官为胰腺'], KnowledgeLevel.TRANSFER,
      ['kn-bio-sr-026', 'kn-bio-sr-029']));
    out.push(k('kn-bio-sr-052', KnowledgeBiologySenior.HOMEOSTASIS, '体液调节', '激素调节的四个特点与下丘脑在内分泌中的枢纽地位',
      '激素调节有四个特点:微量和高效、通过体液运输、作用于靶器官与靶细胞、并存在反馈调节。激素随血液运遍全身而不是只被运往靶器官,只是靶细胞上有特异性受体才起作用,因而受体是激素发挥作用的必要条件;激素既不组成细胞结构、不提供能量、也不起催化作用,只起调节作用,且一经靶细胞接受并起作用后就被灭活,所以机体必须源源不断地产生激素。下丘脑是内分泌活动的枢纽:它既有体温调节、血糖调节与水盐平衡调节的神经中枢,又能分泌促甲状腺激素释放激素和抗利尿激素;抗利尿激素由下丘脑的神经分泌细胞合成、经垂体释放并作用于肾小管与集合管,写成「垂体分泌的」是常见错误。甲状腺激素的分级调节是下丘脑—垂体—甲状腺三个层次,而负反馈抑制的位置在下丘脑与垂体两处而不是只在垂体;缺碘时甲状腺激素合成不足、促甲状腺激素偏高,使甲状腺代偿性增生',
      ['激素随血液运往全身,只作用于靶细胞', '抗利尿激素:下丘脑合成、垂体释放', '反馈抑制部位:下丘脑与垂体'], KnowledgeLevel.APPLY,
      ['kn-bio-sr-029', 'kn-bio-sr-026']));
    out.push(k('kn-bio-sr-053', KnowledgeBiologySenior.HOMEOSTASIS, '体液调节', '血糖平衡的双重调节与两种糖尿病的区别',
      '血糖平衡靠胰岛素与胰高血糖素等相互拮抗又配合来维持:血糖浓度升高时胰岛素分泌增多,促进组织细胞加速摄取、利用和储存葡萄糖并抑制肝糖原分解与非糖物质转化,它是唯一降低血糖的激素;血糖浓度降低时胰高血糖素与肾上腺素分泌增多,促进肝糖原分解和脂肪等非糖物质转化,而肌糖原不能直接分解成葡萄糖补充血糖,故不能把肌糖原列为血糖的直接来源。血糖既受血糖浓度直接刺激胰岛细胞调节,又受下丘脑通过交感与副交感神经的调节,因而它不是只有体液调节;胰岛素与胰高血糖素的分泌还彼此影响。1 型糖尿病因胰岛 B 细胞受损、胰岛素分泌不足,可用注射胰岛素治疗;2 型糖尿病因靶细胞上胰岛素受体的敏感性下降,注射胰岛素并不一定有效。出现尿糖也不能断定血糖过高,一次食糖过多或肾小管重吸收能力有限时同样可有尿糖',
      ['唯一降血糖:胰岛素;升血糖:胰高血糖素、肾上腺素', '肌糖原不直接分解为葡萄糖', '2 型糖尿病:受体不敏感,注射未必有效'], KnowledgeLevel.APPLY,
      ['kn-bio-sr-029', 'kn-bio-sr-026']));
    out.push(k('kn-bio-sr-054', KnowledgeBiologySenior.HOMEOSTASIS, '免疫调节', '免疫系统的三级组成与淋巴细胞成熟部位的差别',
      '免疫系统由免疫器官、免疫细胞与免疫活性物质三个层次组成:免疫器官有骨髓、胸腺、脾、淋巴结与扁桃体,是免疫细胞生成、成熟或集中分布的场所;免疫细胞包括淋巴细胞、树突状细胞与巨噬细胞等,后两者属抗原呈递细胞;免疫活性物质由免疫细胞或其他细胞产生并发挥免疫作用,如抗体、细胞因子与溶菌酶,而溶菌酶不只来自免疫细胞,唾液与泪液中就有,故不能把「有免疫活性物质参与」等同于特异性免疫。淋巴细胞与全部血细胞一样起源于骨髓的造血干细胞,区别在成熟部位:B 淋巴细胞在骨髓中成熟,T 淋巴细胞转移到胸腺中成熟。三道防线中皮肤与黏膜是第一道、体液中的杀菌物质和吞噬细胞是第二道,这两道生来就有、不针对特定病原体,属非特异性免疫;第三道由免疫器官与免疫细胞借助血液循环和淋巴循环组成,只在出生以后逐渐建立、只针对某一特定病原体',
      ['B 细胞在骨髓成熟、T 细胞在胸腺成熟', '非特异性免疫:第一、二道防线'], KnowledgeLevel.RECALL,
      ['kn-bio-sr-026', 'kn-bio-sr-030']));
    out.push(k('kn-bio-sr-055', KnowledgeBiologySenior.HOMEOSTASIS, '免疫调节', '体液免疫的过程与二次免疫更快更强的原因',
      '体液免疫主要靠抗体消灭细胞外的抗原:多数抗原先由抗原呈递细胞摄取、处理并呈递给辅助性 T 细胞,辅助性 T 细胞分泌细胞因子,与抗原的刺激一起使 B 淋巴细胞增殖分化为浆细胞和记忆 B 细胞,而少数抗原可以直接刺激 B 细胞、不需要辅助性 T 细胞参与。浆细胞是唯一能分泌抗体的细胞,但它不能识别抗原,识别靠 B 细胞与记忆细胞膜上的受体,抗体与抗原的结合也不属于细胞的识别;细胞因子只加快增殖分化,不能替代抗原的刺激作用。二次免疫比初次免疫更快更强,是因为记忆细胞在抗原消失后长期存活,再次接触同一种抗原时能迅速增殖分化出大量浆细胞,使抗体产生得快、数量多、维持时间长;疫苗相当于抗原、引起的是一次初次免疫,因此需按程序多次接种以强化记忆',
      ['浆细胞分泌抗体但不能识别抗原', '二次免疫:记忆细胞迅速增殖分化出浆细胞'], KnowledgeLevel.APPLY,
      ['kn-bio-sr-030', 'kn-bio-sr-054']));
    out.push(k('kn-bio-sr-056', KnowledgeBiologySenior.HOMEOSTASIS, '免疫调节', '细胞免疫使靶细胞裂解与三类免疫失调病的对应功能',
      '细胞免疫针对被病原体感染的细胞、癌细胞与移植的器官细胞:靶细胞膜表面分子的变化被细胞毒性 T 细胞识别,在辅助性 T 细胞分泌的细胞因子作用下,细胞毒性 T 细胞增殖分化为新的细胞毒性 T 细胞与记忆 T 细胞,前者与靶细胞密切接触使其裂解、把抗原释放到体液中,释放出的抗原仍要靠抗体消灭或由吞噬细胞吞噬,所以细胞免疫不能直接把病原体清除掉。T 细胞既参与细胞免疫也参与体液免疫,故 HIV 主要攻击辅助性 T 细胞后两类免疫都几乎丧失,病人最终死于严重感染或恶性肿瘤,而不是被病毒直接破坏某种细胞所致。免疫正常时具有免疫防御、免疫自稳与免疫监视三种功能:防御功能过强引起过敏反应,它只发生在已免疫的机体再次接触相同抗原时、一般不破坏组织细胞;防御功能过弱是免疫缺陷病(艾滋病、先天胸腺发育不全);自稳功能异常发生自身免疫病,即免疫系统攻击自身正常组织,如系统性红斑狼疮、类风湿关节炎;监视功能过低则易发生肿瘤。器官移植的排斥主要由 T 细胞介导,使用免疫抑制剂能提高成活率,但代价是机体正常的防御与监视能力同时下降',
      ['细胞免疫裂解靶细胞,抗原仍靠抗体或吞噬细胞', '过敏:再次接触同种抗原、不破坏组织细胞'], KnowledgeLevel.TRANSFER,
      ['kn-bio-sr-030', 'kn-bio-sr-055']));
    out.push(k('kn-bio-sr-057', KnowledgeBiologySenior.HOMEOSTASIS, '植物生命活动的调节', '生长素发现过程中四个实验的结论与各自的不足',
      '生长素的发现是一连串实验而不是某一个结论:达尔文父子证明胚芽鞘感光部位在尖端、弯曲发生在尖端下面一段,切去尖端则既不生长也不弯曲,用不透光的罩遮住尖端只生长而不弯曲,但当时并不能说明尖端产生了什么;鲍森·詹森在尖端与下部之间插入琼脂片后胚芽鞘仍能向光弯曲,而插入云母片则不弯曲,说明尖端产生的刺激可透过琼脂而不能透过云母;拜尔在黑暗中把尖端放在切去尖端的胚芽鞘一侧,胚芽鞘发生弯曲生长,由此提出弯曲是尖端产生的刺激在下部分布不均匀造成的;温特用接触过尖端的琼脂块与未接触过的空白琼脂块对照,排除琼脂本身的作用,才证明这种刺激是化学物质并命名为生长素。这些实验都不能确定生长素的化学本质,吲哚乙酸是后来用理化方法从人尿中分离鉴定出来的;尖端产生生长素而感光也在尖端,但弯曲部位不是尖端,这一区分最常被弄错',
      ['感光部位:尖端;弯曲部位:尖端下面一段', '琼脂片可透过、云母片阻断', '温特对照:空白琼脂块排除琼脂的作用'], KnowledgeLevel.TRANSFER,
      ['kn-bio-sr-031']));
    out.push(k('kn-bio-sr-058', KnowledgeBiologySenior.HOMEOSTASIS, '植物生命活动的调节', '顶端优势的成因、解除与生长素类似物的应用',
      '顶端优势是顶芽产生的生长素经极性运输向下端运并大量积累在侧芽,由于侧芽对生长素比顶芽敏感、较高浓度反而抑制其生长,因而顶芽优先生长而侧芽受抑制;解除的办法是摘除顶芽(棉花打顶、果树整枝、茶树修剪),使侧芽的生长素浓度降低而发育成枝条。生长素类似物如 2,4-D 与 NAA 是人工合成的、作用与生长素相似的物质:处理扦插的枝条可促进生根,低浓度用浸泡法并处理较长时间、高浓度用沾蘸法只需数秒;涂抹番茄、辣椒未受粉的雌蕊柱头可获得无子果实,由于细胞内遗传物质没有改变,这属不可遗传的变异,而三倍体无子西瓜由染色体数目变异而来、其无子性状是可遗传的,两者判据不同;同一类物质浓度较高时可疏花疏果、较低时可防止落花落果,这正是两重性的体现。两重性是生长素作用的特性,而乙烯促进果实成熟、细胞分裂素促进分裂等都谈不上两重性,不能把它套到所有植物激素上',
      ['顶端优势靠摘除顶芽解除', '无子番茄:遗传物质未变、不可遗传', '高浓度疏花疏果、低浓度防落花落果'], KnowledgeLevel.APPLY,
      ['kn-bio-sr-031', 'kn-bio-sr-044']));
    out.push(k('kn-bio-sr-059', KnowledgeBiologySenior.HOMEOSTASIS, '植物生命活动的调节', '其他植物激素的合成部位、作用与植物生长调节剂的特性',
      '除生长素外植物体内还有赤霉素、细胞分裂素、脱落酸、乙烯与油菜素甾醇:赤霉素主要促进细胞伸长从而引起植株增高,并促进种子萌发与果实发育,合成部位以未成熟的种子、幼根和幼芽为主;细胞分裂素促进细胞分裂、诱导芽的分化并延缓叶片衰老,主要由根尖合成;脱落酸抑制细胞分裂、促进叶和果实的衰老与脱落并使气孔关闭,在根冠和萎蔫的叶片中合成较多;乙烯促进果实成熟,植物各部位都能产生,它只促进成熟而不促进果实发育,故不能把「催熟」与「长大」混为一谈;油菜素甾醇促进茎叶细胞扩大与花粉管伸长。赤霉素打破种子休眠而脱落酸维持休眠,两者在萌发上表现为拮抗;生长素浓度升高到一定值时促进乙烯合成,乙烯含量增高又反过来抑制生长素促进细胞伸长的作用,说明激素之间不是各自孤立而是相互调控。植物生长调节剂是人工合成的、与植物激素有类似调节作用的物质,原料广泛、容易合成、效果稳定,但它不是植物激素;其效果与浓度、施用时间和部位及气温密切相关,使用不当反而起抑制作用',
      ['赤霉素打破休眠、脱落酸维持休眠', '乙烯:促进成熟而非促进发育', '生长调节剂效果稳定,但不是植物激素'], KnowledgeLevel.RECALL,
      ['kn-bio-sr-031', 'kn-bio-sr-058']));
    return out;
  }

  /** 选择性必修二:种群、群落、生态系统及其稳定性 */
  static organismAndEnvironment(): KnowledgePoint[] {
    const out: KnowledgePoint[] = [];
    out.push(k('kn-bio-sr-032', KnowledgeBiologySenior.ORGANISM_ENVIRONMENT, '种群和群落', '样方法与标志重捕法的适用对象与估算式',
      '样方法适用于植物以及活动能力弱、活动范围小的动物如蚜虫与跳蝻,关键是随机取样而不掺入主观因素;标志重捕法适用于活动能力强、活动范围大的动物,个体总数 N 等于初次标记数 M 乘重捕总数 n 再除以重捕中被标记数 m,故被标记个体回避重捕或标记物脱落都会使估测值偏大。直接决定种群密度的是出生率与死亡率、迁入率与迁出率,年龄结构通过影响这两率来预测数量变化趋势,性别比例则主要影响出生率',
      ['N = M·n/m', '样方法:植物与活动能力弱的动物'], KnowledgeLevel.TRANSFER, []));
    out.push(k('kn-bio-sr-033', KnowledgeBiologySenior.ORGANISM_ENVIRONMENT, '种群的数量变化', 'J 形与 S 形增长曲线的条件及 K 值的意义',
      'J 形增长出现在食物与空间条件充裕、没有天敌等理想条件下,模型为 N_t = N_0·λ^t,此时增长率不变而增长速率不断增大;S 形增长因资源有限而出现环境阻力,增长速率先增大后减小,在 K/2 时最大而在 K 值时降为零。环境容纳量 K 值随环境条件升降,故灭鼠与防治害虫应设法降低其 K 值,保护濒危动物要提高 K 值,而捕捞应使剩余量不低于 K/2 以保持最大的增长速率',
      ['N_t = N_0·λ^t', '增长速率最大:K/2'], KnowledgeLevel.APPLY, ['kn-bio-sr-032']));
    out.push(k('kn-bio-sr-034', KnowledgeBiologySenior.ORGANISM_ENVIRONMENT, '种群和群落', '群落的物种组成与两种演替的起点差别',
      '物种组成是区别不同群落的重要特征,丰富度指群落中物种数目的多少,而种群密度只描述一个种群;互利共生的两种生物数量曲线同步变化,捕食曲线则呈先增加者先减少的非同步变化。初生演替发生在从未有植被或原有植被被彻底消灭的地方如裸岩、沙丘,要经历地衣、苔藓、草本与灌木阶段,历时很长;次生演替在保留土壤条件与繁殖体的地方如弃耕农田发生,历时较短,而人类活动会使群落演替按不同于自然演替的速度和方向进行',
      ['初生演替:裸岩、沙丘', '次生演替:弃耕农田、火灾后的草原'], KnowledgeLevel.APPLY, ['kn-bio-sr-033']));
    out.push(k('kn-bio-sr-035', KnowledgeBiologySenior.ORGANISM_ENVIRONMENT, '生态系统及其稳定性', '能量单向逐级递减而物质可以反复循环',
      '能量沿食物链以有机物形式传递,单向流动、逐级递减,传递效率约 10%~20%,递减是因为每一营养级都有能量经呼吸散失、被分解者利用或未被利用,因而食物链的营养级一般不超过五个;能量金字塔不可能倒置而数量金字塔可以。物质循环的物质指组成生物体的 C、H、O、N 等元素而非具体化合物,碳在生物群落与无机环境之间以 CO2 形式往返因而具有全球性;能量不能循环而物质可以,故农业上需持续投入能量',
      ['能量传递效率:10%~20%', '物质可循环、能量不循环'], KnowledgeLevel.APPLY, ['kn-bio-sr-034']));
    out.push(k('kn-bio-sr-036', KnowledgeBiologySenior.ORGANISM_ENVIRONMENT, '生态系统及其稳定性', '信息传递往往是双向的与两种稳定性',
      '生态系统中的信息有物理信息(光、声、温度、磁场)、化学信息(有机酸、性外激素)与行为信息(蜜蜂舞蹈)三类,其传递方向往往是双向的,这与能量流动只能单向构成重要区别。抵抗力稳定性指抵抗干扰并使自身结构与功能保持原状的能力,恢复力稳定性指受破坏后恢复原状的能力,二者常常相反但冻原等极端环境中两者都很低;热带雨林抵抗力稳定性高而恢复力稳定性很低,负反馈调节是生态系统自我调节能力的基础',
      ['信息传递双向、能量流动单向', '自我调节能力的基础:负反馈调节'], KnowledgeLevel.APPLY, ['kn-bio-sr-035']));
    out.push(k('kn-bio-sr-060', KnowledgeBiologySenior.ORGANISM_ENVIRONMENT, '种群的数量变化', '种群数量特征的层次关系与年龄结构的预测限度',
      '种群密度是最基本的数量特征,出生率与死亡率、迁入率与迁出率直接决定密度的变化,年龄结构通过影响这两率间接影响密度,性别比例则只通过影响出生率起作用;出生率与死亡率是同一时段内的两个率、不能相加比较,而性别比例并不适用于所有种群,雌雄同体的生物如小麦、蚯蚓就没有这一特征。年龄结构分增长型、稳定型与衰退型三种,它只能预测种群数量的变化方向而不能预测具体数量,趋势能否成为现实还取决于食物、天敌与气候等因素:年龄结构为增长型并不意味着当前数量一定在增加,若迁出率很大仍会下降;稳定型的种群数量也不是恒定不变,而是在 K 值上下波动。调查密度要随机取样并取各样方的平均值,取平均值是为了减小误差而不能剔除「偏大偏小」的数据,调查年龄结构则需统计各年龄组个体所占的比例',
      ['直接决定:出生率、死亡率、迁入与迁出', '年龄结构三型:只预测趋势,不决定数量'], KnowledgeLevel.APPLY,
      ['kn-bio-sr-032', 'kn-bio-sr-033']));
    out.push(k('kn-bio-sr-061', KnowledgeBiologySenior.ORGANISM_ENVIRONMENT, '种群的数量变化', 'λ、增长率与增长速率三者的区别及两条曲线的成因',
      'J 形增长出现在食物和空间条件充裕、气候适宜、没有天敌与其他竞争者的理想条件下,或种群刚迁入一个新环境而适应的初期,如外来入侵物种进入新区域的早期;其模型为 N_t = N_0·λ^t,λ 是当年数量与前一年数量之比,λ>1 时上升、λ=1 时稳定、λ<1 时下降,增长率等于 λ-1 而全程保持不变,增长速率(单位时间内新增的个体数)却随基数增大而不断增大,这三个量的说法不能互换。真实环境中资源总是有限的,种群密度增大后种内斗争加剧、天敌增多,使出生率下降、死亡率上升,于是呈 S 形增长:S 形曲线上增长速率先增大后减小,在 K/2 时最大,到达 K 值时增长速率为 0 而种群数量最大,所以不能说 K 值时种群增长最快。K 值也不是固定不变的,它随环境条件升降,同一物种在不同环境中的 K 值不同,而把 K 值当成种群能达到的最大数量也是错的——种群数量可暂时超过 K 值后再回落',
      ['N_t = N_0·λ^t,增长率 = λ-1 恒定', 'J 形:增长率不变而增长速率增大', 'K 值:增长速率为 0、数量最大且可暂时超过'], KnowledgeLevel.APPLY,
      ['kn-bio-sr-033', 'kn-bio-sr-060']));
    out.push(k('kn-bio-sr-062', KnowledgeBiologySenior.ORGANISM_ENVIRONMENT, '种群的数量变化', '酵母菌种群数量动态变化的计数判点与数量的波动',
      '探究培养液中酵母菌种群数量的变化用抽样检测的方法而不是逐个计数:取样前必须把试管轻轻振荡几次使酵母菌分布均匀,否则吸出的样液中菌数偏多或偏少;用血细胞计数板时应先把盖玻片盖在计数室上、再从边缘滴加培养液让它自行渗入,并用滤纸吸去多余液体,不能先滴液再盖片;压在方格界线上的细胞只统计相邻两边及其顶角上的,菌数过多时先定量稀释再计数。该实验不需要另外设置对照,因为不同时间的取样本身就构成前后自身对照,但要重复计数取平均值以减小误差;要统计活菌数可用台盼蓝染液,死亡的细胞被着色而不计。培养液中酵母菌数量先近似 S 形上升,随后因营养物质消耗、代谢产物酒精积累与 pH 改变而下降,可见种群数量并不是稳定不变的,波动与下降都是正常现象;自然状态下种群数量的变化既受密度因素的制约,也受气候、食物与天敌等非密度因素的影响',
      ['抽样检测 + 血细胞计数板', '先盖盖玻片再滴液,界线只计相邻两边', '自身对照:不同时间取样,无需另设对照'], KnowledgeLevel.TRANSFER,
      ['kn-bio-sr-033', 'kn-bio-sr-012']));
    return out;
  }

