    out.push(k('kn-bio-sr-063', KnowledgeBiologySenior.BIOTECH_ENGINEERING, '发酵工程', '果酒果醋、腐乳与泡菜的菌种、代谢类型与条件控制',
      '四类传统发酵食品的区别在菌种的代谢类型:果酒用酵母菌,它是兼性厌氧的真核生物,先通气让其有氧呼吸大量繁殖、再密封让其无氧呼吸产生酒精,温度控制在 18~25℃,在缺氧并呈酸性的发酵液中酵母菌仍能生存而绝大多数其他微生物因无法适应被抑制,所以不必另外灭菌;果醋用醋酸菌,它是好氧的原核细菌、没有成形的细胞核,必须不断通入无菌空气并把温度控制在 30~35℃,糖源充足时它把糖分解成醋酸,缺少糖源时先把乙醇变成乙醛、再把乙醛变成醋酸,因而果酒做成后可直接用它继续酿醋。腐乳主要靠毛霉等产生的蛋白酶与脂肪酶,前者把蛋白质分解成小分子的肽和氨基酸、后者把脂肪水解成甘油和脂肪酸;盐用量过多影响口味,过少又不足以抑制微生物生长,酒的用量一般控制在 12% 左右而过高会使腐乳成熟时间延长。泡菜靠乳酸菌在无氧条件下把糖分解成乳酸,坛口用水密封以创造无氧环境;发酵过程中亚硝酸盐含量呈先升高后下降的变化,故腌制时间过短、温度过高或食盐用量过低都会使亚硝酸盐偏高而不宜食用',
      ['酵母菌:兼性厌氧、18~25℃;醋酸菌:好氧、30~35℃', '毛霉:蛋白酶 + 脂肪酶', '泡菜:亚硝酸盐先升高后下降'], KnowledgeLevel.APPLY,
      ['kn-bio-sr-037', 'kn-bio-sr-012']));
    out.push(k('kn-bio-sr-064', KnowledgeBiologySenior.BIOTECH_ENGINEERING, '发酵工程', '培养基的成分与消毒、灭菌方法的对应关系',
      '培养基的基本配方都含有水、碳源、氮源和无机盐,还要满足微生物对 pH、特殊营养物质与氧的需求:培养乳酸菌需添加维生素,自生固氮菌的培养基可以不加氮源,硝化细菌等自养菌以 CO2 为碳源,而病毒没有细胞结构、必须寄生在活细胞内,不能用普通培养基培养。消毒只用较温和的物理或化学方法杀死物体表面或内部的部分微生物,不包括芽孢和孢子;灭菌用强烈的理化因素杀死所有微生物,包括芽孢与孢子,两者强度与结果都不同、不能互相替换。方法要按对象选:培养基用高压蒸汽灭菌(103 kPa、121 ℃、15~30 min),接种环与接种针直接灼烧灭菌,玻璃器皿与金属用具用干热灭菌箱,超净工作台用紫外线照射并在使用前用酒精擦拭,不耐高温的尿素溶液等用滤膜过滤除菌。灭菌必须排在接种之前,培养基灭菌后还要冷却到约 50 ℃ 才能倒平板,倒平板与后续划线、涂布都应在酒精灯火焰旁进行,皿盖只开一条缝隙而不能完全打开',
      ['灭菌杀死全部微生物(含芽孢、孢子)', '培养基:高压蒸汽;接种环:灼烧;器皿:干热'], KnowledgeLevel.APPLY,
      ['kn-bio-sr-037']));
    out.push(k('kn-bio-sr-065', KnowledgeBiologySenior.BIOTECH_ENGINEERING, '发酵工程', '两种纯化接种方法、菌种保藏与发酵过程的监控',
      '分离纯化菌种靠两种接种方法:平板划线法用接种环连续划线,把聚集的菌种逐步稀释分散到培养基表面,每次划线之前都要灼烧灭菌、冷却后再从上一区域划线的末端起笔,末了还要灼烧以防污染环境及操作者,能得到单菌落却不能用于计数;稀释涂布平板法把菌液作一系列梯度稀释后涂布,既分离又计数,但统计出的菌落数往往比活菌实际数目偏低,因为两个或多个细胞连在一起时只长出一个菌落,故一般选取菌落数在 30~300 的稀释度、涂布三个以上重复组再取平均。频繁使用的菌种可临时保藏在固体斜面培养基上并置于 4 ℃ 冰箱,但易被污染或产生变异,长期保存用甘油管藏于 -20 ℃ 冷冻箱。罐内的发酵是发酵工程的中心环节,要随时检测温度、pH、溶氧量、通气量以及菌体浓度与产物浓度,并据此调整培养条件与培养基配方;发酵产品分三类:微生物的菌体本身(如单细胞蛋白)、代谢产物(如抗生素、酒精、味精)与酶制剂,后两者的分离、纯化属于发酵工程的下游工序',
      ['平板划线法:能分离而不能计数', '涂布计数偏低:多个细胞连在一起只成一个菌落', '发酵监控:温度、pH、溶氧、通气量、菌体浓度'], KnowledgeLevel.APPLY,
      ['kn-bio-sr-037', 'kn-bio-sr-064']));
    out.push(k('kn-bio-sr-066', KnowledgeBiologySenior.BIOTECH_ENGINEERING, '细胞工程', '植物组织培养的流程、激素配比与光照阶段的相反要求',
      '植物组织培养的流程是离体的器官、组织或细胞(外植体)先经脱分化形成排列疏松而无规则的愈伤组织,再经再分化长出芽和根、发育成完整植株;脱分化阶段要避光,因为光照会促使组织过早分化并变绿,而再分化阶段必须给予光照以诱导叶绿素的合成、使试管苗能自养,两个阶段对光的要求正好相反。培养基中生长素与细胞分裂素的浓度比决定发育方向:比值高时有利于根的分化、比值低时有利于芽的分化、比值适中时只促进愈伤组织的生长,这一配比是关键而不能由其他激素随意代替;培养基中加入的蔗糖既作碳源又维持渗透压,因为愈伤组织不含叶绿体、不能自养。外植体只能消毒而不能灭菌,否则会把它的活细胞杀死、失去材料;已分化的细胞在植物体内没有表现出全能性,不是因为丢失了基因,而是基因在特定时间与空间选择性表达的结果,所以只有离体并给予适宜条件才可能表达全能性',
      ['脱分化:避光;再分化:需光', '生长素/细胞分裂素比值高 → 生根,比值低 → 生芽', '外植体只消毒,不灭菌'], KnowledgeLevel.APPLY,
