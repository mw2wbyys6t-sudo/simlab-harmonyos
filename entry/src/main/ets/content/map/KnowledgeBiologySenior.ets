    out.push(k('kn-bio-sr-028', KnowledgeBiologySenior.HOMEOSTASIS, '神经调节', '兴奋在突触处的传递是单向的',
      '突触由突触前膜、突触间隙与突触后膜组成,兴奋传到突触小体时突触小泡以胞吐方式释放神经递质,与后膜上的特异性受体结合使下一个神经元兴奋或抑制,信号转换是电信号→化学信号→电信号;由于递质只存在于突触前膜的突触小泡中、只能由前膜释放并作用于后膜,所以神经元之间的传递是单向的。递质作用后随即被酶解或回收,有机磷农药使乙酰胆碱不被分解因而肌肉持续收缩',
      ['单向:前膜 → 间隙 → 后膜', '电信号 → 化学信号 → 电信号'], KnowledgeLevel.APPLY, ['kn-bio-sr-027']));
    out.push(k('kn-bio-sr-029', KnowledgeBiologySenior.HOMEOSTASIS, '体液调节', '激素的分级调节、负反馈与协同和拮抗作用',
      '甲状腺激素的分泌存在分级调节:下丘脑分泌促甲状腺激素释放激素作用于垂体,垂体分泌促甲状腺激素作用于甲状腺,而血液中甲状腺激素增多时又反过来抑制下丘脑与垂体,这种负反馈调节在生命系统中很普遍;激素既不组成细胞结构、也不提供能量、还不起催化作用,只起调节作用,且起作用后即被灭活。胰岛素是唯一降低血糖的激素,它与胰高血糖素表现为拮抗,而胰高血糖素与肾上腺素在升高血糖上表现为协同',
      ['下丘脑 → 垂体 → 甲状腺', '胰岛素是唯一降血糖的激素'], KnowledgeLevel.APPLY, ['kn-bio-sr-026']));
    out.push(k('kn-bio-sr-030', KnowledgeBiologySenior.HOMEOSTASIS, '免疫调节', '特异性免疫的两种方式与免疫失调病的区别',
      '皮肤、黏膜与体液中的杀菌物质、吞噬细胞构成不针对特定病原体的非特异性免疫;特异性免疫中体液免疫主要靠浆细胞分泌抗体消灭细胞外的抗原,细胞免疫主要靠细胞毒性 T 细胞使被抗原入侵的靶细胞裂解,多数抗原的体液免疫还需辅助性 T 细胞呈递信息并分泌细胞因子,所以 HIV 攻击辅助性 T 细胞后两类免疫都严重受损。自身免疫病是免疫系统攻击自身正常组织,而过敏反应一般不破坏组织细胞,两者不同',
      ['HIV 攻击辅助性 T 细胞', '二次免疫更快更强:记忆细胞'], KnowledgeLevel.APPLY, ['kn-bio-sr-026']));
    out.push(k('kn-bio-sr-031', KnowledgeBiologySenior.HOMEOSTASIS, '植物生命活动的调节', '生长素的极性运输与生理作用的两重性',
      '生长素主要由幼嫩的芽、叶和发育中的种子合成,并从形态学上端向下端极性运输,这一过程需消耗能量因而属主动运输,颠倒放置不能逆向运输;胚芽鞘的感光部位与产生生长素的部位都在尖端而弯曲发生在尖端下面一段。生长素作用具有两重性:低浓度促进生长、高浓度抑制生长,根、芽、茎的敏感程度依次降低;顶端优势是生长素积累于侧芽使其生长受抑制,而茎的背地性只是近地侧促进生长更快、并不体现两重性',
