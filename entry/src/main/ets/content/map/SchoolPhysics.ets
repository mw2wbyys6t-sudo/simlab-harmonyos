import {
  ExperimentEntry, Feasibility, makeEntry, MapSubject, SchoolStage, UNVERIFIED_PREFIX
} from './CurriculumTypes';

/**
 * 中学物理实验(初中 + 高中)。
 *
 * 这张表补的是地图上的一个真实空洞:应用现在装着的 4 个实验全是中学的,而两张表此前的条目
 * 全是大学段 —— 于是"这个应用能打开什么"在地图上查不到,而"这门课该做什么"却写得满满当当。
 *
 * **`RUNNABLE` 只有 8 条,就是应用里真点得开的那 8 个**(`phy-sr-001` 斜面、`phy-sr-002` 弹簧振子、
 * `phy-jr-001` 串联、`phy-jr-002` 并联、`phy-sr-004` 探究弹簧弹力与形变量的关系、`phy-jr-017` 探究电流与电压电阻的关系、`phy-sr-010` 测量电源的电动势和内阻、`phy-sr-003` 测匀变速加速度),id、标题与学段照
 * `ExperimentRegistry` 的注册项写,
 * 因为它们是拿去核对注册表的。求解器算得出来不等于点得开:2026-10-08 电子那 8 条就是按
 * "MNA 够用"被虚标成可打开的。**引擎够用而应用里还没有这个实验的一律记 `NEEDS_SCENE`** ——
 * 那是"再写一条场景和它的细则"这种活,不动模型不动渲染器。其余四档照 `Feasibility` 的注释判:
 * `NEEDS_MODEL` = 现有 2D 定步长内核 + 七元件直流 MNA + 量取倾倒几何 + 回转体渲染承载不了
 * (流体压强与浮力、刚体静力与转动、热学与气体、电磁感应与变压器、电容、R-T 关系);
 * `NEEDS_RENDERER` = 缺的是画法(光路图、明暗条纹这类电路图之外的示意图);
 * `NEEDS_REAL_GEARS` = 教学目的本身长在手上功夫与实物观察上,**做成仿真就是假实验**。
 * 这一档在中学批里占 14 条(初中 9、高中 5),比大学任何一张表都高 —— 中学实验大量是
 * "调零、估读、匀速拉动、移动找像、把结点拉到同一位置",把仪器换成滑块读数就把目的换掉了。
 *
 * **出处只保证「这个实验确实被列为中小学必做/基本实验」这一件事。**两份清单都是 2026-10-09
 * 真检索到的政府发布页(见下面两个常量),条目名照其编排;但 `principle` / `apparatus` /
 * `dataHandling` 三栏是编写者按该实验的通行做法概括的,不是从页面上逐字抄的,条目名与原文
 * 也可能有一两字出入(目录用「、」与「,」,本表按全应用统一的半角逗号)。`term` 与 `minutes`
 * **不在清单里**:册次按人教版教材的通行排法、课时按"一课时长"给的粗位置,不当作清单信息引用。
 * 清单自己的必修/选必归类与教材册次对不上时按教材走 —— 如「探究产生感应电流的条件」在基本目录里
 * 列于必修 3,而人教版把它放在选择性必修二,本表按后者记 term。
 *
 * 前 4 条 `RUNNABLE` 的出处带 `未核实:` 前缀,理由要说清:它们被机器核对的是"应用里点得开",
 * 而标题用的是应用内的场景名(如「含摩擦的斜面运动」),教材与目录里没有同名条目,
 * 于是"这个实验确实开课"这一层反而没核 —— 顺手在每条 source 里指回它对应的目录项目名。
 * `phy-sr-004` 不同:它的标题就是目录原名,所以出处沿用已核实的 `SRC_SR`,
 * 这条是表里第一条**既点得开、又被目录核过**的实验。
 * 它们的 `apparatus` 记的是这个实验在实体实验室里要用的器材(地图是按图施工的清单),
 * `principle` 与 `dataHandling` 记的才是应用里真正做的事,两条线不打架。
 *
 * `phy-sr-004` 是第一条**由学生按动作、而不是拖滑杆**做起来的实验:加/减砝码与"记录这一读数"
 * 都是离散动作,细则(`bench/RubricSpring`)读的是这些动作留下的后果 —— 越过弹性限度后指针回不到零、
 * 记录瞬间弹簧还在不在动、测了几挡不同载荷、有没有逐次取下做卸载对照。
 * `dataHandling` 里"斜率即 k 并报有效数字""纵轴取总长时截距是原长"这两项**应用判不出来**:
 * 那要学生把数填进来自己算,而现在没有填数的入口(只有自动采样的读数)。这一栏照课程写、
 * 不跟着应用缩水,和电子那张表是同一条规矩。
 *
 * 有意没写的:教育部基本目录初中那 69 项里大量"观察…现象""体验…"属演示与体验类,
 * 不是学生分组实验,不进这张表(如观察扩散现象、观察色光的混合、模拟近视眼与远视眼的矫正、
 * 观察热机的工作过程);传感器类(选必二)与"设计与制作"类(用凸透镜做简易照相机、
 * 简易直流电动机与发电机模型)同理 —— 前者的教学目的在敏感元件与实物接线,后者在动手装配。
 * 初中的「连接串联电路和并联电路」也没单列:它的考核点是实物连线与拆线的手上功夫,
 * 已由 018 条的连线与量程选择承载,再开一条就成了同一目的登记两次。
 * 高中的「探究两个互成角度的力的合成规律」用目录原名(即常说的验证力的平行四边形定则);
 * 「伽利略理想斜面实验」没进表 —— 它是理想实验与推理,不是做得出来的实验。
 */
const PHY: MapSubject = MapSubject.PHYSICS;
const JR: SchoolStage = SchoolStage.JUNIOR;
const SR: SchoolStage = SchoolStage.SENIOR;
const SRC_JR: string = '湖南省教育厅《湖南省初中必做实验目录(2023版)》湘教发[2023]40号(2023-09-08 印发),初中物理 21 条 http://jyt.hunan.gov.cn/jyt/sjyt/jyzbc/zbczcwj/syjx/202503/t20250303_33600704.html';
const SRC_SR: string = '教育部《中小学实验教学基本目录》普通高中物理 79 项(分必修 1-3 与选择性必修 1-3),检索自湖南省教育厅转发页 http://jyt.hunan.gov.cn/sjyt/jyzbc/zbczcwj/syjx/202506/t20250605_33692362.html';
const SRC_APP: string = UNVERIFIED_PREFIX + '标题取应用里的场景名,不是教材目录项目名;所在册次只按场景粗定位';
const SRC_TAO: string = UNVERIFIED_PREFIX + '教学与高考复习里的通行项目,两份目录里没检索到同名条目,只按学生实验的常规做法整理';

function p(id: string, stage: SchoolStage, course: string, term: string, minutes: number,
  title: string, apparatus: string[], principle: string, dataHandling: string,
  knowledge: string[], feasibility: Feasibility, source: string): ExperimentEntry {
  return makeEntry(id, PHY, stage, course, term, minutes, title, apparatus, principle,
    dataHandling, knowledge, feasibility, source);
}

