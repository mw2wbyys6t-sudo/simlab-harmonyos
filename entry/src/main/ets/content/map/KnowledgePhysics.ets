    out.push(k('kn-phy-u-113', KnowledgePhysics.MODERN, '量子概念的引入', '康普顿效应',
      'X 射线被自由电子散射后波长变长 Δλ = (h/mc)(1 − cosθ),且与散射物质无关;它证明光子不仅带能量还带动量 p = h/λ。式中 m 是电子质量,故康普顿波长 λ_C = h/mc 对所有散射体都一样,这正是它区别于原子光谱之处;θ = 0 时 Δλ = 0,背散射 θ = π 时 Δλ = 2λ_C 最大,不是「任何角度都改变」。实验的散射谱上有两条线:一条移位、一条不移位,不能只说「散射后波长都变长」—— 不移位的那条来自被原子束缚很紧的内层电子,是整个原子反冲,等效质量约为原子质量,位移小到测不出。经典电磁理论只能预言散射波长与入射相同,给不出移位线;把散射当作光子与静止自由电子的弹性碰撞、用能量与动量守恒,才能同时给出位移量与反冲电子方向。用轻元素(如石墨)效果明显,重元素中束缚电子占多、移位线弱',
      ['Δλ = λ_C(1 − cosθ)', 'p = h/λ'], KnowledgeLevel.APPLY, ['kn-phy-u-112']));
    out.push(k('kn-phy-u-114', KnowledgePhysics.MODERN, '原子的量子理论', '玻尔氢原子模型',
      '定态假设(角动量量子化 L = nħ)+ 频率条件 hν = E₂ − E₁,给出 E_n = −13.6/n² eV 与半径 a₀n²;巴耳末系等谱线系由能级差直接算出。负号表示束缚态,电离能是 |E₁| = 13.6 eV;该式只对氢与类氢离子成立,核电荷为 Z 时要乘 Z²(E_n = −13.6Z²/n²),多电子原子有屏蔽与电子相互作用,公式不再适用,这是玻尔模型最主要的失效处。光子吸收或发射的能量必须恰好等于两能级之差,而用电子碰撞激发时入射动能只要不小于能级差即可(多余动能保留),弗兰克-赫兹实验依据的是后者,两种激发的条件不能混为一谈。处于 n 能级的原子向低能级跃迁可给出 n(n−1)/2 条谱线,不是一个「系」。玻尔写的 L = nħ 与量子力学的 √(l(l+1))ħ(l = 0…n−1)并不一致,n = 1 时后者给出角动量为零;定态不辐射是假设而非推论,玻尔轨道不能当真实轨迹',
      ['E_n = −13.6/n² eV', '类氢 E_n = −13.6Z²/n² eV'], KnowledgeLevel.APPLY, ['kn-phy-u-112']));
    out.push(k('kn-phy-u-115', KnowledgePhysics.MODERN, '原子的量子理论', '德布罗意波与波粒二象性',
      '实物粒子也有波动性,λ = h/p;电子衍射(戴维孙-革末)证实之。宏观物体波长极短故波动性不可见 —— 这不是假设而是与光电、康普顿共同构成的对称图景',
      ['λ = h/p'], KnowledgeLevel.APPLY, ['kn-phy-u-113']));
    out.push(k('kn-phy-u-116', KnowledgePhysics.MODERN, '原子的量子理论', '不确定性原理',
      '位置与动量不能同时确定,Δx·Δp ≥ ħ/2(能量与时间同理)。它不是测量技术的缺陷,而是波粒二象性的必然结果,并解释了原子基态不坍缩',
      ['Δx Δp ≥ ħ/2'], KnowledgeLevel.RECALL, ['kn-phy-u-115']));
    out.push(k('kn-phy-u-117', KnowledgePhysics.MODERN, '原子的量子理论', '波函数与玻恩统计解释',
      '微观状态由波函数 Ψ(r,t) 描述,|Ψ|² 是概率密度(不是实在的物质密度);波函数须单值、有限、连续并归一化 ∫||²dV = 1',
      ['∫|Ψ|² dV = 1'], KnowledgeLevel.APPLY, ['kn-phy-u-115']));
    out.push(k('kn-phy-u-118', KnowledgePhysics.MODERN, '原子的量子理论', '定态薛定谔方程与一维无限深势阱',
      '−(ħ²/2m)∇²ψ + Uψ = Eψ;势阱宽度 L 内解得 E_n = n²π²ħ²/(2mL²),能量量子化与零点能都由边界条件自然出现,不需额外假设。定态方程只对势能不显含时间的系统成立,含时问题必须回到含时薛定谔方程,不能用它代替。无限深势阱的边界条件是阱外 ψ = 0 且阱壁处波函数连续为零(无限高壁完全不穿透),这正是量子化的唯一来源;E_n ∝ n²/L²,故阱越窄能级间隔越大,而间距随 n 增大也增大(非等间隔),不能拿氢原子「能级越来越密」来套。n 只能取 1,2,3…:n = 0 使 ψ ≡ 0 不是物理状态,所以零点能 E₁ = π²ħ²/(2mL²) 不为零,与不确定性原理一致(被束缚的粒子动量不能为零),不要以为基态动能为零。|ψ|² 有节点,n = 2 时阱中心概率密度为零,这只表示在那里测不到粒子,不能推成「粒子不能越过中心」',
      ['E_n ∝ n²', 'E₁ ≠ 0 (零点能)'], KnowledgeLevel.TRANSFER, ['kn-phy-u-117']));
    out.push(k('kn-phy-u-119', KnowledgePhysics.MODERN, '原子的量子理论', '氢原子的四个量子数',
      '主量子数 n 定能量、角量子数 l 定轨道角动量大小、磁量子数 m 定空间取向、自旋磁量子数 m_s 定自旋投影;l 取 0…n−1,m 取 −l…+l,这是泡利不相容原理的前提',
      ['L = √(l(l+1))ħ'], KnowledgeLevel.APPLY, ['kn-phy-u-118']));
    out.push(k('kn-phy-u-120', KnowledgePhysics.MODERN, '原子核与粒子', '核的组成、放射性衰变与半衰期',
      '原子核由质子与中子组成,质量数 A = Z + N;α、β、γ 三种射线分别对应氦核、电子(或正电子)与光子,衰变服从 N = N₀e^(−λt),半衰期 T₁/₂ = ln2/λ。质量数是核子个数(整数),核的实际质量并不等于 Z 个质子与 N 个中子质量之和(有质量亏损),不能把质量数当质量;同位素是 Z 相同而 N 不同,化学性质几乎一样而放射性不同。α 衰变使 A 减 4、Z 减 2;β⁻ 放出的电子来自核内中子转变为质子(同时放出反中微子),不是核外电子,故 Z 加 1 而 A 不变;γ 只是核从激发态跃迁到较低能态,不改变 Z 与 A,常伴随 α 或 β 发生,不能把它当成与前两者并列的第三种「核成分」。N = N₀e^(−λt) 与 T½ = ln2/λ 是统计规律,只对大量原子核成立,对「某一个核下个半衰期内是否衰变」没有预测力;衰变快慢与温度、压强、化学状态基本无关,不能靠加热或加压加速。经过 n 个半衰期剩 (1/2)ⁿ,两个半衰期后还剩四分之一而非衰变完',
      ['T_½ = ln2/λ', 'β⁻ 放出反中微子'], KnowledgeLevel.APPLY, ['kn-phy-u-114']));
    out.push(k('kn-phy-u-121', KnowledgePhysics.MODERN, '原子核与粒子', '质量亏损与结合能',
      '核质量小于其核子质量之和,亏损 Δm 对应结合能 ΔE = Δmc²;比结合能曲线在铁附近最高,故重核裂变与轻核聚变都放能。Δm 是核质量与自由核子质量之和的差,若改用中性原子质量计算,两端电子数必须一致,否则电子质量会被误算进亏损。判断稳定性要看比结合能(每个核子的结合能)而不是总结合能:铀的总结合能最大而比结合能低于铁,所以它并不如铁稳定。裂变与聚变放能是因为产物的比结合能更高(向铁靠拢),不是「质量变成了能量」:减少的是静止质量,同时以辐射与动能形式带走能量,质能相应的总能量仍守恒,不宜说成相互转化。用 E = mc² 时代入 kg 得到的是焦耳,常按 1 u 对应 931.5 MeV 换算,混用单位是易错处。反应能否自发进行要看总动能是否增加(即总静止质量是否减少),只盯某一个核的质量增减会判错',
      ['E = mc²', '1 u 对应 931.5 MeV/c²'], KnowledgeLevel.APPLY, ['kn-phy-u-120']));
    out.push(k('kn-phy-u-122', KnowledgePhysics.MODERN, '激光与固体', '受激辐射与激光的特性',
      '粒子数反转下受激辐射超过自发辐射,谐振腔选模放大后得到方向性好、单色性与相干性高、亮度大的激光;它需要亚稳态能级才能维持反转。粒子数反转(上能级粒子数多于下能级)是必要条件而非充分条件:热平衡下玻尔兹曼分布永远不可能反转,所以必须靠泵浦持续输入能量;还要增益超过腔的损耗(阈值条件),达不到阈值就只有放大自发辐射而不出激光。受激辐射产生的光子与入射光子同频率、同相位、同方向、同偏振,这才是相干性与方向性的来源,自发辐射是随机的;谐振腔的选模决定方向性与单色性,而不是反转本身。亚稳态能级寿命长,便于积累反转,普通激发态寿命太短,粒子来不及积累就辐射掉了。激光「单色性好」不等于只含一个频率(可以有多纵模),亮度大指单位面积单位立体角内的能量密度高,并不表示总功率一定大',
      ['粒子数反转', '阈值: 增益 ≥ 损耗'], KnowledgeLevel.RECALL, ['kn-phy-u-114']));
    return out;
  }

  static all(): KnowledgePoint[] {
    return KnowledgePhysics.mechanics().concat(KnowledgePhysics.thermodynamics())
      .concat(KnowledgePhysics.electromagnetism()).concat(KnowledgePhysics.optics())
      .concat(KnowledgePhysics.modern());
  }
