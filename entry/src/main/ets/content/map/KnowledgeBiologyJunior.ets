      ['kn-bio-jr-014', 'kn-bio-jr-013']));
    out.push(k('kn-bio-jr-016', KnowledgeBiologyJunior.SEVENTH_LOWER, '人体的排泄', '尿液的形成与排泄、排遗的区别',
      '肾单位是形成尿液的基本结构单位,由肾小球、肾小囊和肾小管组成;血液流经肾小球时,除血细胞和大分子蛋白质外,血浆中的一部分水、无机盐、葡萄糖和尿素被滤过到肾小囊腔中形成原尿,所以正常原尿里有葡萄糖;原尿流经肾小管时,全部的葡萄糖、大部分水和部分无机盐被重新吸收回血液,剩下的成为尿液,因而正常人的尿液中不含葡萄糖;尿的形成是连续的而排出是间断的,因为膀胱能暂时贮存尿液,排尿反射还受大脑控制;排出二氧化碳、尿素和多余的水叫排泄,而食物残渣排出体外叫排遗,不属于排泄',
      ['肾小球滤过→原尿', '肾小管重吸收→尿液'], KnowledgeLevel.APPLY, ['kn-bio-jr-015']));
    return out;
  }

  /** 八年级上:第四单元 人体生理与健康(二)、第五单元 生物与环境 */
  static eighthUpper(): KnowledgePoint[] {
    const out: KnowledgePoint[] = [];
    out.push(k('kn-bio-jr-017', KnowledgeBiologyJunior.EIGHTH_UPPER, '神经系统', '反射必须经过完整的反射弧',
      '反射是人体通过神经系统对外界或内部刺激作出的规律性反应,是神经调节的基本方式,它必须依靠完整的反射弧才能实现,反射弧由感受器、传入神经、神经中枢、传出神经和效应器五部分组成,其中任何一处被破坏,反射都不能完成;若只有传出神经或效应器受损,刺激感受器仍有感觉但没有反应,若传入神经或神经中枢受损则连感觉也没有;膝跳反射、缩手反射的神经中枢在脊髓,是生来就有的简单反射(非条件反射),望梅止渴、谈虎色变需要大脑皮层参与,是后天形成的复杂反射(条件反射),它会建立也会消退;先缩手后感到疼痛,是因为痛觉要在大脑皮层形成、传导路径更长',
      ['感受器→传入神经→神经中枢→传出神经→效应器'], KnowledgeLevel.APPLY, []));
    out.push(k('kn-bio-jr-018', KnowledgeBiologyJunior.EIGHTH_UPPER, '激素调节', '生长激素与甲状腺激素分泌异常对应的病症',
      '激素由内分泌腺分泌、不经导管而直接进入腺体内的毛细血管,在血液中含量极少却对生长发育和生殖等生命活动起着重要调节作用;垂体分泌的生长激素幼年分泌不足患侏儒症(身材矮小而智力正常)、分泌过多患巨人症,这是它与甲状腺激素不足引起的呆小症(身材矮小且智力低下)最常被混淆之处;缺碘会使甲状腺代偿性增生而患地方性甲状腺肿,甲状腺激素还能提高神经系统的兴奋性、分泌过多则患甲亢;胰岛分泌的胰岛素不足会引起糖尿病,胰岛素制剂只能注射不能口服,因为它属蛋白质、口服会被消化分解而失效',
      ['侏儒症:智力正常', '呆小症:智力低下'], KnowledgeLevel.RECALL, ['kn-bio-jr-017']));
    out.push(k('kn-bio-jr-019', KnowledgeBiologyJunior.EIGHTH_UPPER, '免疫与健康', '传染病流行的三个环节与非特异性、特异性免疫',
      '传染病由病原体(细菌、病毒、寄生虫等)引起,具有传染性和流行性,流行的三个环节是传染源、传播途径和易感人群,预防相应地分为控制传染源(隔离治疗患者、处理患病的动物)、切断传播途径(消毒、洗手、戴口罩、消灭蚊蝇)和保护易感人群(接种疫苗、加强锻炼),消灭蚊蝇属切断传播途径而不是控制传染源;皮肤和黏膜构成第一道防线、体液中的杀菌物质和吞噬细胞构成第二道防线,这两道生来就有、对多种病原体都起作用,属非特异性免疫;第三道防线由免疫器官和免疫细胞组成、只针对某一特定的病原体起作用,属特异性免疫;能引起淋巴细胞产生抗体的物质是抗原,疫苗是用灭活的或减毒的病原体制成的生物制品,接种后人体自己产生抗体,而注射抗毒血清是直接输入现成的抗体',
      ['三环节:传染源、传播途径、易感人群', '抗原→抗体'], KnowledgeLevel.APPLY, ['kn-bio-jr-006']));
    out.push(k('kn-bio-jr-020', KnowledgeBiologyJunior.EIGHTH_UPPER, '生态系统', '生态系统的组成、食物链与生物富集',
      '在一定空间范围内生物与环境所形成的统一整体叫生态系统,它由非生物部分(阳光、水、空气、温度等)和生物部分组成,植物是生产者、动物是消费者、细菌和真菌是分解者,分解者把动植物遗体分解成二氧化碳、水和无机盐又被植物重新利用;食物链里只有生产者与消费者,不含分解者和非生物部分,起点必须是生产者、箭头指向捕食者并表示物质和能量流动的方向;物质和能量沿食物链传递而逐级减少,营养级越高的生物体内积累的有毒物质(如 DDT)越多,这是生物富集;生态系统具有一定的自动调节能力但超过限度就会遭到破坏,生物种类越多、食物网越复杂,调节能力越强',
      ['食物链:生产者→消费者', '能量沿营养级逐级递减'], KnowledgeLevel.RECALL, ['kn-bio-jr-006']));
    return out;
  }

  /** 八年级下:第六单元 生命的延续和发展 */
  static eighthLower(): KnowledgePoint[] {
    const out: KnowledgePoint[] = [];
    out.push(k('kn-bio-jr-021', KnowledgeBiologyJunior.EIGHTH_LOWER, '生物的生殖', '有性生殖与无性生殖的根本区别',
      '不经过两性生殖细胞的结合、由母体直接产生新个体的是无性生殖,如植物的扦插、嫁接、压条和组织培养,以及细菌的分裂生殖、酵母菌的出芽生殖,后代只具有母体的遗传特性,因而能稳定保持亲本的优良性状且繁殖速度快;经过精子与卵细胞结合形成受精卵、再由受精卵发育成新个体的是有性生殖,后代具备父母双方的遗传物质,变异性强、更能适应变化的环境;嫁接成活的关键是让接穗与砧木的形成层紧密结合,苹果、梨等果树常用嫁接繁殖;试管婴儿虽然受精在体外完成,仍有两性生殖细胞的结合,属有性生殖;家蚕、菜粉蝶经过卵、幼虫、蛹、成虫四个时期是完全变态,蝗虫只经过卵、若虫、成虫三个时期是不完全变态,青蛙的发育属变态发育且生殖与幼体发育都离不开水',
      ['无性生殖只具母体遗传特性', '完全变态:卵→幼虫→蛹→成虫'], KnowledgeLevel.RECALL, []));
    out.push(k('kn-bio-jr-022', KnowledgeBiologyJunior.EIGHTH_LOWER, '遗传与变异', '染色体、DNA 与基因三者的包含关系',
      '细胞核中被碱性染料染成深色的物质是染色体,它由 DNA 和蛋白质组成,DNA 是主要的遗传物质、呈双螺旋结构;DNA 上具有特定遗传效应的片段就是基因,基因通过指导蛋白质的合成来控制生物的性状;体细胞中染色体成对存在、基因也成对存在,而在精子或卵细胞中染色体数目减半、成单存在,受精后受精卵内的染色体数目又恢复到与体细胞相同,这正是亲子代染色体数目保持恒定的原因;人正常体细胞有 46 条即 23 对染色体,生殖细胞有 23 条;一个 DNA 分子上有许多基因而不是只有一个,线粒体和叶绿体中也有 DNA 和基因',
      ['染色体 = DNA + 蛋白质', '人:体细胞 46 条、生殖细胞 23 条'], KnowledgeLevel.RECALL, ['kn-bio-jr-004']));
    out.push(k('kn-bio-jr-023', KnowledgeBiologyJunior.EIGHTH_LOWER, '遗传与变异', '显性性状与隐性性状的判断及基因组成的推导',
      '同种生物同一性状的不同表现类型叫相对性状,如豌豆的高茎与矮茎、人的双眼皮与单眼皮;控制显性性状的基因用大写、控制隐性性状的用小写,基因组成为 AA 或 Aa 都表现显性性状,只有 aa 才表现隐性性状,所以表现隐性性状的个体必是纯合子,而表现显性性状的个体不一定是纯合子;基因组成为 Aa 的一对个体杂交,后代 AA:Aa:aa=1:2:1,性状表现为显性:隐性=3:1;两个双眼皮父母生出单眼皮孩子,说明单眼皮是隐性性状且父母的基因组成都是 Aa;判断显隐性的常用依据是亲代都没有的性状在子代出现,则该性状为隐性;由环境引起而遗传物质未改变的变异不能遗传,如穗大粒饱来自水肥充足',
      ['AA:Aa:aa = 1:2:1', '显性:隐性 = 3:1'], KnowledgeLevel.APPLY, ['kn-bio-jr-022']));
    out.push(k('kn-bio-jr-024', KnowledgeBiologyJunior.EIGHTH_LOWER, '生物的进化', '达尔文自然选择学说的四点内容与选择的方向',
      '自然界中的生物通过激烈的生存斗争,适应者生存、不适应者被淘汰,这就是自然选择,它包括过度繁殖、生存斗争、遗传和变异、适者生存四个方面;生物的变异是不定向的,而环境的选择是定向的,自然选择决定生物进化的方向,所以长颈鹿颈和前肢变长不是因为「经常伸长」这种获得性遗传(拉马克的用进废退说),而是不定向变异被定向选择的结果;害虫对农药的抗药性在使用农药之前就已存在,农药只是把有抗药性的个体选择出来而不是使害虫产生抗药性;化石是研究生物进化最重要的直接证据,进化的总体趋势是从简单到复杂、从低等到高等、从水生到陆生',
      ['变异不定向,选择定向'], KnowledgeLevel.APPLY, ['kn-bio-jr-023']));
    return out;
  }

  static all(): KnowledgePoint[] {
    return KnowledgeBiologyJunior.seventhUpper().concat(KnowledgeBiologyJunior.seventhLower())
      .concat(KnowledgeBiologyJunior.eighthUpper()).concat(KnowledgeBiologyJunior.eighthLower());
  }
}
