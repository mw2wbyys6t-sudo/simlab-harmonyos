    out.push(k('kn-bio-jr-044', KnowledgeBiologyJunior.EIGHTH_LOWER, '遗传与变异', '基因在亲子代间传递的桥梁与人的性别遗传',
      '亲代通过生殖细胞把基因传给子代,精子与卵细胞(而非体细胞)是基因在亲子代间传递的「桥梁」;体细胞中染色体、基因成对存在,而生殖细胞中染色体减半、基因成单,受精后又恢复成对,这正是后代兼具父母双方遗传物质的原因;人的性别由性染色体决定,男性为 XY、女性为 XX,精子有两种(含 X 或含 Y)、卵细胞只有一种(含 X);生男生女取决于与卵细胞结合的是哪种精子:含 X 精子得 XX(女)、含 Y 精子得 XY(男),两种精子与卵细胞结合的机会均等,所以生男生女比例接近 1:1,并不是由母亲或「命」决定;Y 染色体只由父亲传给儿子,据此可判断某致病基因的来源',
      ['桥梁=生殖细胞而非体细胞', '性别取决于父方精子(X 或 Y)'], KnowledgeLevel.APPLY, ['kn-bio-jr-022']));
    out.push(k('kn-bio-jr-045', KnowledgeBiologyJunior.EIGHTH_LOWER, '生物的进化', '研究生物进化的化石证据与分子生物学证据',
      '化石是保存在地层中的古代生物的遗体、遗物或生活痕迹,是研究进化最直接、最重要的证据;在地层里越古老的地层中成为化石的生物越简单、越低等、水生越多,越晚近的地层中则越复杂、越高等、陆生越多,据此可推知由简单到复杂、由低等到高等、由水生到陆生的进化趋势;除化石外,比较解剖学上的同源器官(如人的手臂、鸟的翼、鲸的鳍,结构相似而功能不同)说明这些生物有共同的原始祖先;分子生物学证据则通过比较细胞色素 C 等蛋白质的氨基酸差异来推断亲缘关系——差异越小亲缘关系越近,人与黑猩猩的细胞色素 C 差异最小、与酵母菌差异最大,这不能等同于外形相似就是近亲;达尔文的自然选择(变异不定向、选择定向)是对进化原因的解释,而非证据本身',
      ['越古老地层化石越低等', '细胞色素 C 差异越小亲缘越近'], KnowledgeLevel.APPLY, ['kn-bio-jr-024']));
    return out;
  }

  static all(): KnowledgePoint[] {
    const rows: KnowledgePoint[] = KnowledgeBiologyJunior.seventhUpper().concat(KnowledgeBiologyJunior.seventhLower())
      .concat(KnowledgeBiologyJunior.eighthUpper()).concat(KnowledgeBiologyJunior.eighthLower());
    // 新增条目按 2024 册次归到各自分组方法末尾,拼接顺序不再等于 id 顺序;这里按 id 归位,
    // 使 all() 稳定输出 001→045 的连续顺序,也让「前置指向 id 更小者」等价于「位置更靠前」。
    rows.sort((a: KnowledgePoint, b: KnowledgePoint): number =>
      Number(a.id.substring(a.id.lastIndexOf('-') + 1)) - Number(b.id.substring(b.id.lastIndexOf('-') + 1)));
    return rows;
  }
}
