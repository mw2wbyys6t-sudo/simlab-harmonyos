  /** 八年级下:第六单元 生命的延续和发展 */
  static eighthLower(): KnowledgePoint[] {
    const out: KnowledgePoint[] = [];
    out.push(k('kn-bio-jr-021', KnowledgeBiologyJunior.EIGHTH_LOWER, '生物的生殖', '有性生殖与无性生殖的根本区别',
      '不经过两性生殖细胞的结合、由母体直接产生新个体的是无性生殖，如植物的扦插、嫁接、压条和组织培养，以及细菌的分裂生殖、酵母菌的出芽生殖，后代只具有母体的遗传特性，因而能稳定保持亲本的优良性状且繁殖速度快；经过精子与卵细胞结合形成受精卵、再由受精卵发育成新个体的是有性生殖，后代具备父母双方的遗传物质，变异性强、更能适应变化的环境；判断属于哪一类只看一条——新个体是不是由受精卵发育来的，而不是看受精发生在体内还是体外，也不是看亲本会不会开花，所以「试管婴儿」虽在体外完成受精仍属有性生殖，马铃薯块茎、菊花扦插长成新植株即便亲本正在开花也仍是无性生殖；把「繁殖快、后代多」写成有性生殖的优点是记反了，保持亲本优良性状、繁殖快属无性生殖，后代变异性强、更能适应变化的环境才是有性生殖的长处；嫁接成活的关键是让接穗与砧木的形成层紧密结合，苹果、梨等果树常用嫁接繁殖；家蚕、菜粉蝶经过卵、幼虫、蛹、成虫四个时期是完全变态，蝗虫只经过卵、若虫、成虫三个时期是不完全变态，青蛙的发育属变态发育且生殖与幼体发育都离不开水',
      ['无性生殖只具母体遗传特性', '完全变态:卵→幼虫→蛹→成虫'], KnowledgeLevel.RECALL, []));
    out.push(k('kn-bio-jr-022', KnowledgeBiologyJunior.EIGHTH_LOWER, '遗传与变异', '染色体、DNA 与基因三者的包含关系',
