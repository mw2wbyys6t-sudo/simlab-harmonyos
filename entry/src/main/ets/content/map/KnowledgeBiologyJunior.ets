  /** 七年级下:第三单元 植物的生活、第四单元 人体生理与健康(一) */
  static seventhLower(): KnowledgePoint[] {
    const out: KnowledgePoint[] = [];
    out.push(k('kn-bio-jr-007', KnowledgeBiologyJunior.SEVENTH_LOWER, '植物的生活', '种子萌发的环境条件与自身条件',
      '环境条件是适宜的温度、一定的水分和充足的空气,三者缺一不可,而光照和土壤的肥沃程度并不是种子萌发所必需的,所以把种子放进干燥肥沃的土里或放进冰箱都不萌发;自身条件是胚必须是完整的、活的,种子不处于休眠期,并有供胚发育的营养物质,因此煮熟的种子和被虫蛀空胚的种子都不能萌发;萌发所需的营养来自子叶或胚乳而不是外界土壤,菜豆双子叶靠子叶、玉米单子叶靠胚乳;胚由胚芽、胚轴、胚根和子叶组成,将来发育成茎和叶的是胚芽、发育成根的是胚根,所以胚是新植物体的幼体',
      ['子叶或胚乳供营养', '胚芽→茎和叶、胚根→根'], KnowledgeLevel.RECALL, []));
    out.push(k('kn-bio-jr-008', KnowledgeBiologyJunior.SEVENTH_LOWER, '植物的生活', '对照实验的单一变量原则',
      '探究某种条件对生物的影响时,必须使除这一条件不同以外其他条件都相同且适宜,这个不同的条件就是所要研究的变量,没有对照组就无法说明结果是由该条件引起的;探究光对鼠妇分布的影响时一侧遮光一侧透光,而两侧的湿度、温度必须相同,若一侧还更干燥就出现了两个变量、结论不可靠;统计时要用十只左右的鼠妇并重复几次取平均值,只用一只会因为个体差异和偶然性得出错误结论;对照组通常是处于正常或自然状态的那一组,而经实验处理的那一组是实验组',
      ['一次只改变一个条件', '多次重复取平均值'], KnowledgeLevel.APPLY, ['kn-bio-jr-007']));
    out.push(k('kn-bio-jr-009', KnowledgeBiologyJunior.SEVENTH_LOWER, '植物的生活', '蒸腾作用与水分、有机物在植物体内的运输',
      '根吸收水分主要靠根尖的成熟区，水分和无机盐经木质部中的导管自下而上运输，绝大部分通过叶片的气孔以水蒸气形式散失，这就是蒸腾作用，它还是植物吸收水分并向上运输水分、无机盐的动力，也能降低叶片表面温度；「植物吸收的水主要用于光合作用」是把水的去处记错了，判它只要称重：浇足水的盆栽连同托盘一起称，光下一段时间后减掉的水几乎都是从气孔散失的，留在体内和被光合作用用掉的只占很少一部分；气孔由一对保卫细胞控制开闭，观察叶片下表皮时，成对的半月形细胞含有叶绿体、是保卫细胞，周围形状不规则、无色透明的表皮细胞不含叶绿体，把「表皮细胞也有叶绿体」写成对的，是把叶片里的细胞一律当成了含叶绿体；有机物由韧皮部的筛管向下运输，木本植物的茎环剥一圈树皮后，切口上方膨大成瘤而叶片并不萎蔫，因为向上运水的木质部没有被动过，这个现象判出向下运输有机物的是韧皮部而不是木质部，也判出瘤只长在切口上方而不是下方',
      ['导管(木质部):水与无机盐↑', '筛管(韧皮部):有机物↓'], KnowledgeLevel.RECALL, ['kn-bio-jr-007']));
    out.push(k('kn-bio-jr-010', KnowledgeBiologyJunior.SEVENTH_LOWER, '植物的光合作用与呼吸作用', '绿叶在光下制造淀粉的实验步骤与设计意图',
      '实验先把天竺葵放到黑暗处一昼夜,目的是把叶片中原有的淀粉运走耗尽,这样检测到的淀粉才只能是实验期间新制造的;再用黑纸片把叶片的一部分从上下两面遮盖起来后移到阳光下照射,这是设置见光与不见光的对照;几小时后摘下叶片,放入盛酒精的小烧杯隔水加热,叶绿素溶于酒精使叶片变成黄白色、酒精变绿,隔水是为了防止酒精燃烧;用清水漂洗后滴加碘液,见光部分变蓝、遮光部分不变蓝,说明光合作用的产物是淀粉、光是光合作用不可缺少的条件;银边天竺葵的白边与绿边对照还能说明叶绿体是光合作用的场所',
      ['淀粉遇碘变蓝', '酒精脱色必须隔水加热'], KnowledgeLevel.TRANSFER, ['kn-bio-jr-008']));
    out.push(k('kn-bio-jr-011', KnowledgeBiologyJunior.SEVENTH_LOWER, '植物的光合作用与呼吸作用', '植物在光下同时进行光合作用和呼吸作用',
      '光合作用在有光的条件下于叶绿体中进行，把二氧化碳和水转化成储存能量的有机物并放出氧气；呼吸作用则时时刻刻都在进行，有光无光都进行，在线粒体里分解有机物、释放能量供各项生命活动利用；最常写的一句是「植物在光下只进行光合作用、在夜里只进行呼吸作用」，等于把光当成了呼吸作用的开关，判它要看实验取材：验证植物呼吸放出二氧化碳必须用萌发的种子或根这类不含叶绿体、不能进行光合作用的部位，把气体通入澄清石灰水，若改用绿色叶片在光下做这个实验，石灰水几乎不变浑浊，那是新放出的二氧化碳立刻被叶绿体吸收了，看不到浑浊并不等于没有呼吸；「光下整株吸收二氧化碳、放出氧气」讲的是测得的现象，由它只能得出光下光合作用强于呼吸作用，不能写成呼吸作用停止；夜里光合作用停止而呼吸作用继续，所以卧室内放大量的花卉会让人不适；光照增强、二氧化碳浓度增大都能提高光合作用强度，合理密植、增施「气肥」和兼作套种都是据此来提高产量',
      ['光合:CO₂ + H₂O →(叶绿体、光)有机物 + O₂', '呼吸:有机物 + O₂ → CO₂ + H₂O + 能量'], KnowledgeLevel.APPLY,
      ['kn-bio-jr-010', 'kn-bio-jr-009']));
    out.push(k('kn-bio-jr-012', KnowledgeBiologyJunior.SEVENTH_LOWER, '人体的消化与吸收', '三类营养物质的消化起始部位与小肠的吸收结构',
      '淀粉的消化从口腔开始,唾液淀粉酶把它分解成麦芽糖;蛋白质的消化从胃开始,由胃蛋白酶初步分解;脂肪只在小肠内被消化;三者最终都在小肠里被分解成可吸收的小分子,即葡萄糖、氨基酸、甘油和脂肪酸;肝脏分泌的胆汁不含任何消化酶,却能乳化脂肪成微小液滴来增大酶的作用面积,所以「胆汁能消化脂肪」这一说法并不准确;小肠很长、内表面有皱褶和小肠绒毛、绒毛壁和毛细血管壁都只由一层上皮细胞构成,这些特点使它成为消化和吸收的主要场所;胃只能吸收少量的水、无机盐和酒精,大肠只吸收少量的水、无机盐和部分维生素',
      ['淀粉→葡萄糖', '蛋白质→氨基酸', '脂肪→甘油 + 脂肪酸'], KnowledgeLevel.RECALL, []));
    out.push(k('kn-bio-jr-013', KnowledgeBiologyJunior.SEVENTH_LOWER, '人体的呼吸', '呼吸运动引起的肺内气压变化与肺泡内的气体交换',
      '吸气时肋间肌与膈肌收缩,胸廓扩大、膈顶部下降,肺随之扩张,肺内气压低于外界大气压,气体进入肺,呼气时相反,所以气体进出肺靠的是气压差;肺泡外包绕着丰富的毛细血管,肺泡壁和毛细血管壁都只由一层上皮细胞构成,氧和二氧化碳靠气体扩散作用完成交换,于是血液由含氧少、颜色暗红的静脉血变成含氧丰富、颜色鲜红的动脉血;呼出的气体中氧气含量仍然高于二氧化碳,只是氧气减少、二氧化碳增多,所以它能使澄清石灰水变浑浊却不能说「呼出的全是二氧化碳」;吸入的氧随血液运到组织细胞,最终在线粒体里参与有机物的氧化分解',
      ['吸气:肺内气压 < 外界气压', '肺泡处:静脉血 → 动脉血'], KnowledgeLevel.APPLY, ['kn-bio-jr-011']));
    out.push(k('kn-bio-jr-014', KnowledgeBiologyJunior.SEVENTH_LOWER, '血液循环', '血液的组成与三种血细胞的功能',
      '血液由血浆和血细胞组成,血浆大部分是水,功能是运载血细胞、运输维持生命活动所需的物质和体内产生的废物;成熟的红细胞没有细胞核、呈两面凹的圆盘状,因而不能分裂、寿命较短,它富含的血红蛋白在含氧高的地方容易与氧结合、在含氧低的地方容易与氧分离,使红细胞能运输氧,它也能运输一部分二氧化碳,数量过少或血红蛋白过少都会贫血;白细胞有细胞核、能吞噬病菌,数目明显增多提示身体有炎症;血小板没有细胞核、形状不规则,有止血和加速凝血的作用;血液由血浆这一液体部分和血细胞构成,属于结缔组织',
      ['血红蛋白:氧多则结合、氧少则分离', '成熟红细胞无细胞核'], KnowledgeLevel.RECALL, ['kn-bio-jr-003']));
    out.push(k('kn-bio-jr-015', KnowledgeBiologyJunior.SEVENTH_LOWER, '血液循环', '体循环与肺循环及动脉血、静脉血的判断',
      '体循环从左心室出发,经主动脉及其分支到达全身各处毛细血管网,再由上、下腔静脉回到右心房;肺循环从右心室出发,经肺动脉到达肺部毛细血管网,由肺静脉回到左心房,两条循环途径同时进行并在心脏处连通;判断动脉血还是静脉血看的是含氧多少与颜色,而不是它流在哪条血管里,所以肺动脉里流的是静脉血、肺静脉里流的是动脉血,这是最容易错的一处;心室壁比心房壁厚、左心室壁最厚,与它把血液输送到全身的距离相适应;心房与心室之间的房室瓣、心室与动脉之间的动脉瓣保证血液只能单向流动而不倒流,静脉内还有静脉瓣',
      ['左心室→主动脉→全身→右心房', '右心室→肺动脉→肺→左心房'], KnowledgeLevel.APPLY,
      ['kn-bio-jr-014', 'kn-bio-jr-013']));
    out.push(k('kn-bio-jr-016', KnowledgeBiologyJunior.SEVENTH_LOWER, '人体的排泄', '尿液的形成与排泄、排遗的区别',
      '肾单位是形成尿液的基本结构单位，由肾小球、肾小囊和肾小管组成；血液流经肾小球时，除血细胞和大分子蛋白质外，血浆中的一部分水、无机盐、葡萄糖和尿素被滤过到肾小囊腔中形成原尿，所以正常原尿里有葡萄糖；原尿流经肾小管时，全部的葡萄糖、大部分水和部分无机盐被重新吸收回血液，剩下的成为尿液，因而正常人的尿液中不含葡萄糖；尿在肾单位中是连续形成的而排出是间断的，因为膀胱只暂时贮存尿液、并不形成尿液，把「尿是膀胱产生的」写进答案就错了，间断排尿这个现象判出的是贮存这一环，不能拿它去说肾脏也是间断工作的，排尿反射的中枢在脊髓、还受大脑控制；排出二氧化碳、尿素和多余的水叫排泄，食物残渣排出体外叫排遗、不属于排泄，两者不能只看是不是排到了体外，要问它是不是细胞生命活动产生并经血液运来的废物：粪便里的物质没有进入过细胞、也没经血液运来，所以排便不是排泄；出汗排出水、无机盐和少量尿素，属于排泄',
      ['肾小球滤过→原尿', '肾小管重吸收→尿液'], KnowledgeLevel.APPLY, ['kn-bio-jr-015']));
    out.push(k('kn-bio-jr-032', KnowledgeBiologyJunior.SEVENTH_LOWER, '植物的生活', '花的结构与果实、种子的来源及可食部分的对应',
      '一朵花中最重要的是雄蕊和雌蕊,因为它们与果实和种子的形成直接相关;受精完成后,子房发育成果实、子房壁发育成果皮、胚珠发育成种子、受精卵发育成胚,而花瓣、雄蕊、柱头、花柱一般逐渐凋落;所以「果实由子房发育来、种子由胚珠发育来」,不能记反;判断某种可食部分属于谁要看它的来源:桃子、西瓜的果肉是果皮(由子房壁发育来),而玉米、小麦的「种子」其实是果皮与种皮紧贴在一起的果实(颖果),草莓的红色部分主要是花托膨大而来,并非子房发育的果实;要结出果实必须经历传粉和受精两个过程,缺少其中之一就不能正常结果',
      ['子房→果实、胚珠→种子', '桃肉是果皮,玉米粒是果实'], KnowledgeLevel.APPLY, ['kn-bio-jr-007']));
    out.push(k('kn-bio-jr-033', KnowledgeBiologyJunior.SEVENTH_LOWER, '植物的生活', '根吸水的部位与无机盐缺乏的症状',
      '根吸收水分和无机盐的主要部位是根尖的成熟区,因为它生有大量根毛、扩大了吸收面积;伸长区细胞迅速伸长是根生长最快的部位,分生区只负责分裂产生新细胞;移栽幼苗时根部带一个土坨,是为了保护幼根和根毛、提高成活率,而不是为了多带些水分;植物生长需要量最大的无机盐是含氮、含磷、含钾的,缺氮植株矮小瘦弱、叶片发黄,缺磷植株特别矮小、叶片呈暗绿色并出现紫色,缺钾茎秆软弱、叶片边缘和尖端呈褐色并焦枯,三者症状不同易混;施肥后必须浇水,否则土壤溶液浓度过高会使根失水而「烧苗」',
      ['成熟区(根毛)吸水', '氮黄、磷紫、钾焦边'], KnowledgeLevel.RECALL, ['kn-bio-jr-009']));
    out.push(k('kn-bio-jr-034', KnowledgeBiologyJunior.SEVENTH_LOWER, '植物的光合作用与呼吸作用', '光合作用与呼吸作用在条件、场所、原料产物上的对照及一昼夜气体曲线',
      '光合作用只在有光时于叶绿体中进行,把二氧化碳和水合成有机物、储存能量并放出氧气;呼吸作用有光无光都在每一活细胞的线粒体进行,分解有机物、释放能量并产生二氧化碳和水,二者原料与产物正好相反、场所不同、能量变化也相反(一个储能一个放能);在密闭环境中测一昼夜二氧化碳(或氧气)变化曲线时,上升段表示呼吸强度大于光合、下降段表示光合大于呼吸,曲线的转折点(最高或最低处)正是光合速率等于呼吸速率的那一刻,而不是光合作用刚开始或停止;所以整株在光下也一直在呼吸,只是光合强于呼吸才表现为吸收二氧化碳',
      ['场所:叶绿体 vs 线粒体', '曲线转折点=光合速率=呼吸速率'], KnowledgeLevel.TRANSFER, ['kn-bio-jr-011']));
    out.push(k('kn-bio-jr-035', KnowledgeBiologyJunior.SEVENTH_LOWER, '人体的消化与吸收', '消化道与消化腺的组成、各自分泌物及吸收部位',
      '消化道由口腔、咽、食道、胃、小肠、大肠、肛门组成,是最长而盘曲的小肠成为消化和吸收的主要场所;消化腺分两类:位于消化道外的大消化腺有唾液腺、肝脏、胰腺,它们通过导管把消化液送入小肠或口腔,而胃腺、肠腺是位于消化道壁内的小腺体;肝脏是人体最大的消化腺,分泌的胆汁不含消化酶、储存在胆囊,只能乳化脂肪;胰腺分泌的胰液和肠腺分泌的肠液里含有能消化糖类、蛋白质、脂肪的多种酶;吸收上小肠是主要场所,胃只吸收少量水、无机盐和酒精,大肠只吸收少量水、无机盐和部分维生素,食道和咽几乎不吸收;注意「胆汁能消化脂肪」的说法不准确,乳化不等于分解',
      ['肝脏最大,分泌胆汁无酶', '小肠是消化吸收主要场所'], KnowledgeLevel.RECALL, ['kn-bio-jr-012']));
    out.push(k('kn-bio-jr-036', KnowledgeBiologyJunior.SEVENTH_LOWER, '人体的呼吸', '模拟膈肌运动演示肺与外界气体交换的原理',
      '肺与外界的气体交换(肺的通气)靠呼吸运动实现,其直接原因是肺内气压与外界大气压之差;用玻璃罩代表胸廓、气球代表肺、橡皮膜代表膈肌的模型演示:向下拉橡皮膜相当于膈肌收缩、膈顶下降,罩内(胸廓)容积增大、气压下降,气球随之胀大表示吸气;向上回弹相当于膈肌舒张、容积减小、气压升高,气球缩小表示呼气;所以是「气压差导致气体流动」而不是肺主动把气吸进来;吸气时肋间肌也收缩使胸廓前后、左右径增大;模型里气球胀大是气压降低的结果,不能反过来说先胀大才让气压变低',
      ['膈肌收缩→容积↑→气压↓→吸气', '通气动力=肺内与外界气压差'], KnowledgeLevel.APPLY, ['kn-bio-jr-013']));
    out.push(k('kn-bio-jr-037', KnowledgeBiologyJunior.SEVENTH_LOWER, '人体的排泄', '肾单位的结构与尿液形成的两个过程及三种液体成分对照',
      '肾单位是肾脏结构和功能的基本单位,由肾小球、肾小囊和肾小管组成,注意肾小球是毛细血管球而不是细胞;尿的形成经过两个过程:血液流经肾小球时发生滤过作用,除血细胞和大分子蛋白质外,血浆中的一部分水、无机盐、葡萄糖、尿素滤过到肾小囊腔形成原尿;原尿流经肾小管时发生重吸收作用,其中全部的葡萄糖、大部分水和部分无机盐被重新吸收回血液,剩下的形成尿液;由此对照三种液体成分:血浆含蛋白质、葡萄糖、尿素等,原尿含葡萄糖而无大分子蛋白质,正常尿液既无葡萄糖又几乎无蛋白质而含较多尿素;若尿中出现葡萄糖,病变部位多在肾小管(重吸收能力有限)而非肾小球;出现大分子蛋白质或血细胞则提示肾小球病变',
      ['滤过→原尿,重吸收→尿液', '原尿有葡萄糖、尿液没有'], KnowledgeLevel.TRANSFER, ['kn-bio-jr-016']));
    out.push(k('kn-bio-jr-038', KnowledgeBiologyJunior.SEVENTH_LOWER, '血液循环', '动脉、静脉、毛细血管的结构与血流速度对照及出血判断',
      '动脉把血液从心脏送到全身,管壁厚、弹性大、血流速度最快,多分布较深;静脉把血液送回心脏,管壁较薄、弹性小、血流速度慢,四肢静脉内有防止倒流的静脉瓣;毛细血管数量大、内径极小、只允许红细胞单行通过、管壁只由一层上皮细胞构成、血流最慢,这些特点使它成为血液与组织细胞充分进行物质交换的场所;判断出血类型要看血色和流出方式:动脉出血血色鲜红、呈喷射状,应在近心端(靠心一侧)压迫止血;静脉出血血色暗红、缓缓流出,应在远心端止血;毛细血管出血渗出、一般能自行止血;注意血流速度是动脉>静脉>毛细血管,而物质交换主要只在毛细血管进行',
