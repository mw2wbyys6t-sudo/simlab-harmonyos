    out.push(k('kn-bio-jr-012', KnowledgeBiologyJunior.SEVENTH_LOWER, '人体的消化与吸收', '三类营养物质的消化起始部位与小肠的吸收结构',
      '淀粉的消化从口腔开始,唾液淀粉酶把它分解成麦芽糖;蛋白质的消化从胃开始,由胃蛋白酶初步分解;脂肪只在小肠内被消化;三者最终都在小肠里被分解成可吸收的小分子,即葡萄糖、氨基酸、甘油和脂肪酸;肝脏分泌的胆汁不含任何消化酶,却能乳化脂肪成微小液滴来增大酶的作用面积,所以「胆汁能消化脂肪」这一说法并不准确;小肠很长、内表面有皱褶和小肠绒毛、绒毛壁和毛细血管壁都只由一层上皮细胞构成,这些特点使它成为消化和吸收的主要场所;胃只能吸收少量的水、无机盐和酒精,大肠只吸收少量的水、无机盐和部分维生素',
      ['淀粉→葡萄糖', '蛋白质→氨基酸', '脂肪→甘油 + 脂肪酸'], KnowledgeLevel.RECALL, []));
    out.push(k('kn-bio-jr-013', KnowledgeBiologyJunior.SEVENTH_LOWER, '人体的呼吸', '呼吸运动引起的肺内气压变化与肺泡内的气体交换',
      '吸气时肋间肌与膈肌收缩,胸廓扩大、膈顶部下降,肺随之扩张,肺内气压低于外界大气压,气体进入肺,呼气时相反,所以气体进出肺靠的是气压差;肺泡外包绕着丰富的毛细血管,肺泡壁和毛细血管壁都只由一层上皮细胞构成,氧和二氧化碳靠气体扩散作用完成交换,于是血液由含氧少、颜色暗红的静脉血变成含氧丰富、颜色鲜红的动脉血;呼出的气体中氧气含量仍然高于二氧化碳,只是氧气减少、二氧化碳增多,所以它能使澄清石灰水变浑浊却不能说「呼出的全是二氧化碳」;吸入的氧随血液运到组织细胞,最终在线粒体里参与有机物的氧化分解',
      ['吸气:肺内气压 < 外界气压', '肺泡处:静脉血 → 动脉血'], KnowledgeLevel.APPLY, ['kn-bio-jr-011']));
    out.push(k('kn-bio-jr-014', KnowledgeBiologyJunior.SEVENTH_LOWER, '血液循环', '血液的组成与三种血细胞的功能',
