import { KnowledgePoint, KnowledgeLevel, makeKnowledge } from './KnowledgeTypes';
import { MapSubject, SchoolStage } from './CurriculumTypes';

/**
 * 初中生物知识点(人教版)。
 *
 * 与 KnowledgePhysicsJunior 同一套标准:一条 = 能被单独提问、单独判对错的最小单元,
 * 章名用作浏览页的二级分组标题,粒度不超出教材的节。
 *
 * **册次口径:人教版 2024 年新教材,七年级上/下、八年级上/下各一册。**
 * 这一版按《义务教育生物学课程标准(2022年版)》重排过内容,和上一版(2012/2013)差别不小:
 * 植物的生活(种子萌发、光合作用、呼吸作用、蒸腾作用)在**七下**(第三单元);
 * 动物的类群、微生物、生物分类在**七上**(第二单元 多种多样的生物);
 * 生态系统与生物圈在**八上**(第五单元 生物与环境);
 * 人体生命活动的调节与健康地生活(传染病、免疫)在**八上**(第四单元 后半);
 * 生物的生殖与遗传变异、进化在**八下**(第六单元 生命的延续和发展)。
 * 目录经在线电子课本目录页(haoduoyun.cc、zxkeben.szxuexiao.com、keben1.com、keben.app)核实,
 * **但未核对纸质教材与 2022 版课标原文**。
 *
 * 同物理那两张初中表一样,`source` 只为**覆盖面与排列顺序**作证;每条 statement 里的生物
 * 内容本身是可判对错的命题,靠初中生物的专业判断与易错点核,不靠引用。初中生物的易错点
 * 密度高(光下也呼吸、肺动脉流静脉血、成熟红细胞无核、反射离不了完整反射弧),这一表优先收这些。
 */
const BIO: MapSubject = MapSubject.BIOLOGY;
const JR: SchoolStage = SchoolStage.JUNIOR;
const COVERAGE: string = '按人教版(2024)新教材四册编排覆盖面与顺序,目录经在线电子课本目录页核实,未核对纸质教材与课标原文';

function k(id: string, course: string, chapter: string, title: string, statement: string,
  symbols: string[], level: KnowledgeLevel, prereq: string[]): KnowledgePoint {
  return makeKnowledge(id, BIO, JR, course, chapter, title, statement, symbols,
    level, prereq, COVERAGE);
}

export class KnowledgeBiologyJunior {
  static readonly SEVENTH_UPPER: string = '七年级上';
  static readonly SEVENTH_LOWER: string = '七年级下';
  static readonly EIGHTH_UPPER: string = '八年级上';
  static readonly EIGHTH_LOWER: string = '八年级下';

  /** 七年级上:第一单元 生物和细胞、第二单元 多种多样的生物 */
  static seventhUpper(): KnowledgePoint[] {
    const out: KnowledgePoint[] = [];
    out.push(k('kn-bio-jr-001', KnowledgeBiologyJunior.SEVENTH_UPPER, '生物与细胞', '判断一个物体是否生物的依据',
      '生物在生活过程中需要营养、能呼吸、能排出体内产生的废物、能对外界刺激作出反应、能生长和繁殖,除病毒外都由细胞构成;判断某物体是不是生物要看它是否具备这些特征,而不是会不会动、会不会变大,钟乳石慢慢「长大」和珊瑚礁不断堆积都只是碳酸钙沉积,既不能新陈代谢也不能繁殖,所以不是生物;病毒没有细胞结构,却能靠在宿主细胞里增殖来繁殖后代,因此是生物',
      ['病毒无细胞结构', '判据:能否新陈代谢与繁殖'], KnowledgeLevel.RECALL, []));
    out.push(k('kn-bio-jr-002', KnowledgeBiologyJunior.SEVENTH_UPPER, '生物与细胞', '显微镜的放大倍数与物像的移动方向',
      '显微镜的放大倍数等于目镜倍数乘以物镜倍数,放大的是长度或宽度而不是面积或体积;因为显微镜成的是倒立的像,物像在视野右上方时要向右上方移动装片才能把它移到中央;换用高倍物镜后视野变暗、细胞体积变大而数目变少,此时只能调节细准焦螺旋而不能再动粗准焦螺旋,想看清细胞数目多用低倍镜、想看清细胞结构用高倍镜;镜头上无螺纹的是目镜,有螺纹的是物镜,物镜越长放大倍数越大',
      ['放大倍数 = 目镜 × 物镜', '物像偏哪,装片就往哪移'], KnowledgeLevel.APPLY, []));
    out.push(k('kn-bio-jr-003', KnowledgeBiologyJunior.SEVENTH_UPPER, '生物与细胞', '植物细胞与动物细胞结构的相同点与不同点',
      '两者都有细胞膜、细胞质、细胞核和线粒体,植物细胞还另有细胞壁和液泡,绿色部分的细胞才有叶绿体;叶绿体并非植物细胞都有,根尖细胞和表皮细胞就没有,所以「植物细胞都有叶绿体」是错的;细胞膜能控制物质进出,菠菜被水煮后水变绿就说明膜失去了控制作用,而细胞壁是全透的、只起支持和保护作用;线粒体和叶绿体都是能量转换器,前者把有机物里的化学能释放出来,后者把光能转变成化学能',
      ['细胞壁、液泡、叶绿体为植物所特有'], KnowledgeLevel.RECALL, ['kn-bio-jr-002']));
    out.push(k('kn-bio-jr-004', KnowledgeBiologyJunior.SEVENTH_UPPER, '生物与细胞', '细胞分裂、生长与分化及遗传物质的稳定',
      '分裂使细胞数目增多、生长使细胞体积增大、分化形成不同的组织;分裂时染色体先复制加倍再平均分配到两个新细胞中,所以新细胞与原细胞的染色体形态和数目相同、遗传物质保持不变;分化只是形态结构、功能和分布发生变化,遗传物质并没有改变,所以「分化使细胞里的基因发生变化」是错的;动物细胞分裂时细胞膜从中部向内凹陷,植物细胞则在中央形成新的细胞膜和细胞壁;细胞不能无限长大,是因为体积增大后表面积与体积之比减小,物质运输满足不了细胞需要',
      ['染色体先复制后均分', '分化不改变遗传物质'], KnowledgeLevel.RECALL, ['kn-bio-jr-003']));
    out.push(k('kn-bio-jr-005', KnowledgeBiologyJunior.SEVENTH_UPPER, '生物与细胞', '动物体与植物体结构层次的差异',
      '动物体的结构层次是细胞→组织→器官→系统→动物体,植物体没有系统这一层次,由器官直接构成;血液属于结缔组织而不是器官,心脏、脑、皮肤和叶都是器官,皮肤还是人体最大的器官;番茄果实的表皮起保护作用属保护组织,人皮肤的表皮起保护作用却属上皮组织,二者功能相当而名称与来源不同;绿色开花植物有根、茎、叶、花、果实、种子六种器官,前三者属营养器官、后三者属生殖器官;酵母菌、草履虫、衣藻这样整个身体只有一个细胞、却能独立完成营养呼吸排泄生殖等生命活动的,属于单细胞生物',
      ['植物没有系统这一层次', '血液是组织,皮肤是器官'], KnowledgeLevel.RECALL, ['kn-bio-jr-004']));
    out.push(k('kn-bio-jr-006', KnowledgeBiologyJunior.SEVENTH_UPPER, '微生物', '细菌、真菌与病毒三者在结构上的差别',
      '细菌是单细胞个体,没有成形的细胞核、只有 DNA 集中的区域,属原核生物,靠分裂生殖,有些还有鞭毛和荚膜,芽孢是它抵抗不良环境的休眠体而不是生殖细胞;真菌有真正的细胞核,属真核生物,酵母菌是单细胞、多进行出芽生殖,霉菌和蘑菇等多细胞真菌靠孢子繁殖;病毒没有细胞结构,只由蛋白质外壳和内部的遗传物质组成,不能独立生活,必须寄生在活细胞里才能增殖,寄生在细菌里的病毒叫噬菌体;三类生物都没有叶绿体,因而大多数只能利用现成的有机物生活、营养方式为异养,只有少数细菌(如蓝细菌、硝化细菌)能自己制造有机物',
      ['细菌:无成形细胞核', '病毒:蛋白质外壳 + 遗传物质'], KnowledgeLevel.RECALL, ['kn-bio-jr-003']));
    return out;
  }

  /** 七年级下:第三单元 植物的生活、第四单元 人体生理与健康(一) */
  static seventhLower(): KnowledgePoint[] {
    const out: KnowledgePoint[] = [];
    out.push(k('kn-bio-jr-007', '七年级上', '植物的生活', '种子萌发的环境条件与自身条件',
      '环境条件是适宜的温度、一定的水分和充足的空气,三者缺一不可,而光照和土壤的肥沃程度并不是种子萌发所必需的,所以把种子放进干燥肥沃的土里或放进冰箱都不萌发;自身条件是胚必须是完整的、活的,种子不处于休眠期,并有供胚发育的营养物质,因此煮熟的种子和被虫蛀空胚的种子都不能萌发;萌发所需的营养来自子叶或胚乳而不是外界土壤,菜豆双子叶靠子叶、玉米单子叶靠胚乳;胚由胚芽、胚轴、胚根和子叶组成,将来发育成茎和叶的是胚芽、发育成根的是胚根,所以胚是新植物体的幼体',
      ['子叶或胚乳供营养', '胚芽→茎和叶、胚根→根'], KnowledgeLevel.RECALL, []));
    out.push(k('kn-bio-jr-008', '七年级上', '植物的生活', '对照实验的单一变量原则',
      '探究某种条件对生物的影响时,必须使除这一条件不同以外其他条件都相同且适宜,这个不同的条件就是所要研究的变量,没有对照组就无法说明结果是由该条件引起的;探究光对鼠妇分布的影响时一侧遮光一侧透光,而两侧的湿度、温度必须相同,若一侧还更干燥就出现了两个变量、结论不可靠;统计时要用十只左右的鼠妇并重复几次取平均值,只用一只会因为个体差异和偶然性得出错误结论;对照组通常是处于正常或自然状态的那一组,而经实验处理的那一组是实验组',
      ['一次只改变一个条件', '多次重复取平均值'], KnowledgeLevel.APPLY, ['kn-bio-jr-007']));
    out.push(k('kn-bio-jr-009', '七年级上', '植物的生活', '蒸腾作用与水分、有机物在植物体内的运输',
      '根吸收水分主要靠根尖的成熟区,水分和无机盐经木质部中的导管自下而上运输,绝大部分通过叶片的气孔以水蒸气形式散失,这就是蒸腾作用;它是植物吸收水分并运输水分、无机盐的动力,还能降低叶片表面温度,所以「植物吸收的水主要用于光合作用」是错的,真正被光合作用利用的只占很少一部分;气孔由一对保卫细胞控制开闭,保卫细胞既有叶绿体也有细胞核,而表皮细胞没有叶绿体;有机物由韧皮部的筛管向下运输,把树皮环剥一圈后有机物运不到根,切口上方会形成瘤状膨大、根会因得不到营养而死亡',
      ['导管(木质部):水与无机盐↑', '筛管(韧皮部):有机物↓'], KnowledgeLevel.RECALL, ['kn-bio-jr-007']));
    out.push(k('kn-bio-jr-010', '七年级上', '植物的光合作用与呼吸作用', '绿叶在光下制造淀粉的实验步骤与设计意图',
      '实验先把天竺葵放到黑暗处一昼夜,目的是把叶片中原有的淀粉运走耗尽,这样检测到的淀粉才只能是实验期间新制造的;再用黑纸片把叶片的一部分从上下两面遮盖起来后移到阳光下照射,这是设置见光与不见光的对照;几小时后摘下叶片,放入盛酒精的小烧杯隔水加热,叶绿素溶于酒精使叶片变成黄白色、酒精变绿,隔水是为了防止酒精燃烧;用清水漂洗后滴加碘液,见光部分变蓝、遮光部分不变蓝,说明光合作用的产物是淀粉、光是光合作用不可缺少的条件;银边天竺葵的白边与绿边对照还能说明叶绿体是光合作用的场所',
      ['淀粉遇碘变蓝', '酒精脱色必须隔水加热'], KnowledgeLevel.TRANSFER, ['kn-bio-jr-008']));
    out.push(k('kn-bio-jr-011', '七年级上', '植物的光合作用与呼吸作用', '植物在光下同时进行光合作用和呼吸作用',
      '光合作用在有光的条件下于叶绿体中进行,把二氧化碳和水转化成储存能量的有机物并放出氧气;呼吸作用则时时刻刻都在进行,有光无光都进行,在线粒体里分解有机物、释放能量供各项生命活动利用,所以「植物在光下只进行光合作用而不进行呼吸作用」是错的,只是因为光下光合作用强于呼吸作用,整株才表现为吸收二氧化碳、释放氧气;夜里只进行呼吸作用,因而卧室里放大量花卉会让人不适;光照增强、二氧化碳浓度增大都能提高光合作用强度,合理密植、增施「气肥」和兼作套种都是据此来提高产量',
      ['光合:CO₂ + H₂O →(叶绿体、光)有机物 + O₂', '呼吸:有机物 + O₂ → CO₂ + H₂O + 能量'], KnowledgeLevel.APPLY,
