  /** 第四~六单元:自然界的水、化学反应的定量关系、碳和碳的氧化物 */
  static unitsFourToSix(): KnowledgePoint[] {
    const out: KnowledgePoint[] = [];
    out.push(k('kn-chem-jr-009', KnowledgeChemistryJunior.GRADE9, '自然界的水', '电解水实验与水的组成',
      '水在直流电作用下分解,与电源正极相连的管内得到氧气、负极管内得到氢气,二者体积比约为 1:2,而质量比约为 8:1,不能把这两个比混为一谈;正极气体使带火星的木条复燃、负极气体能燃烧并产生淡蓝色火焰,由此证明水由氢、氧两种元素组成,而不是由氢气和氧气组成;常加入少量氢氧化钠或稀硫酸以增强水的导电性;该实验还能反过来印证化学变化中分子可分而原子不可分,以及一种元素在反应前后种类不变',
      ['2H₂O →(通电) 2H₂↑ + O₂↑', 'V(H₂) : V(O₂) ≈ 2 : 1'], KnowledgeLevel.APPLY, ['kn-chem-jr-006', 'kn-chem-jr-008']));
    out.push(k('kn-chem-jr-010', KnowledgeChemistryJunior.GRADE9, '自然界的水', '水的净化方法与硬水、软水的鉴别',
      '常用净水操作按净化程度由低到高是静置沉淀、加明矾吸附沉降、过滤、活性炭吸附、蒸馏：沉淀和过滤只除去不溶性杂质，活性炭靠吸附除去色素和异味，蒸馏净化程度最高、所得蒸馏水才可看作纯净物；水变澄清并不等于得到了纯水，硬水其实是均一、稳定的溶液而不是悬浊液，其中可溶的钙、镁化合物靠静置和过滤都除不掉，取少量蒸干、看有没有固体留下才分得清这两种水；肥皂水只能用来鉴别硬水和软水，泡沫多浮渣少的是软水、泡沫少浮渣多的是硬水，它并不能降低水的硬度，真正能软化水的是生活中的煮沸和实验室里的蒸馏；「一贴二低三靠」是过滤的操作要点，过滤后液体仍浑浊可能是滤纸破损或液面高于滤纸边缘，需要再过滤一次',
