import { KnowledgePoint, KnowledgeLevel, makeKnowledge } from './KnowledgeTypes';
import { MapSubject, SchoolStage } from './CurriculumTypes';

/**
 * 初中化学知识点(人教版九年级)。
 *
 * 与 KnowledgePhysicsJunior 同一套标准:一条 = 能被单独提问、单独判对错的最小单元,
 * chapter 用作浏览页的二级分组标题,粒度不超出教材的课题。
 *
 * **册次口径:按本项目定为「九年级」一册,故全部条目共用一个 course。**
 * 单元名取人教版(2024)九年级上册编排(走进化学世界/空气和氧气/物质构成的奥秘/自然界的水/
 * 化学反应的定量关系/碳和碳的氧化物/能源的合理利用与开发),下册(金属和金属材料/溶液/常见的酸碱和盐/化学与生活)
 * 仍按 2012 部编版。「化学式与化合价」按教材排在第四单元「自然界的水」的课题 4,本表随教材而不随内容归类。
 *
 * **出处说明:** 上册(第一~七单元)单元名按 2024 版核实(经 zxkeben.szxuexiao.com、keben1.com 在线目录确认),
 * 第二单元改名「空气和氧气」、第五单元改名「化学反应的定量关系」、第七单元改名「能源的合理利用与开发」。
 * 下册(第八~十二单元)仍用 2012 部编版名称,未核对 2024 版下册是否已出版。
 *
 * 与另外几张知识表一样,`source` 只为**覆盖面与排列顺序**作证;每条 statement 里的化学内容
 * 本身是可判对错的命题,靠初中化学的专业判断与高频易错判据核(催化剂不改产量、
 * 原子是化学变化中最小粒子但不是最小微粒、溶液不一定无色、饱和不一定是浓溶液、
 * 着火点不能被降低、铁反应生成 +2 价、pH 试纸不许润湿),不靠引用。
 *
 * 前置只引用**本文件内序号更小的 id**,不跨文件(初中物理那张表与自己无关),
 * 也不引用大学条目 —— 校验器只在传给它的那一批里查引用,跨文件的引用会被判成悬挂。
 */
const CHEM: MapSubject = MapSubject.CHEMISTRY;
const JR: SchoolStage = SchoolStage.JUNIOR;
const COVERAGE: string = '上册(1-7单元)按人教版(2024)核实,下册(8-12单元)按2012部编版,目录经在线电子课本目录页核实,未核对纸质教材';

function k(id: string, course: string, chapter: string, title: string, statement: string,
  symbols: string[], level: KnowledgeLevel, prereq: string[]): KnowledgePoint {
  return makeKnowledge(id, CHEM, JR, course, chapter, title, statement, symbols,
    level, prereq, COVERAGE);
}

export class KnowledgeChemistryJunior {
  /** 人教版初中化学只有九年级这一册(全一册),不写上下 */
  static readonly GRADE9: string = '九年级';

