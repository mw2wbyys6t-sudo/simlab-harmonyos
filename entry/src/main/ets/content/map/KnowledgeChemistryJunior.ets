    const out: KnowledgePoint[] = [];
    out.push(k('kn-chem-jr-025', KnowledgeChemistryJunior.GRADE9, '常见的酸和碱', '常见酸的性质与酸的通性',
      '浓盐酸有挥发性,打开瓶盖瓶口出现白雾,那是挥发出的氯化氢与水蒸气结合成的盐酸小液滴而不是氯化氢气体;浓硫酸有吸水性可作干燥剂,还能把纸张、皮肤里的氢、氧元素按水的组成脱去而使其碳化,稀释时必须把浓硫酸沿器壁慢慢注入水里并不断搅拌,切不可把水注入浓硫酸,因为溶于水放出大量热且水密度小会浮在上面造成酸液飞溅;酸有相似的化学性质是因为它们在水溶液里都能解离出氢离子:使紫色石蕊变红而无色酚酞不变色、与较活泼金属反应生成盐和氢气、与金属氧化物反应生成盐和水、与碱和某些盐反应;盐酸除铁锈时溶液变黄、硫酸用于金属除锈和铅蓄电池',
      ['HCl、H₂SO₄ 解离出 H⁺ ⇒ 酸的通性', 'Fe₂O₃ + 6HCl → 2FeCl₃ + 3H₂O', '酸入水、沿壁流、不断搅拌'], KnowledgeLevel.APPLY, ['kn-chem-jr-022', 'kn-chem-jr-011']));
