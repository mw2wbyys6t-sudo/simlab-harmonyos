import { KnowledgePoint, KnowledgeLevel, makeKnowledge } from './KnowledgeTypes';
import { MapSubject, SchoolStage, UNVERIFIED_PREFIX } from './CurriculumTypes';

/**
 * 初中电子学知识点。
 *
 * **这张表填的是「电子学·初中」这个原本 0 条的格子。** 初中阶段没有独立的电子学课本,
 * 这些内容散在物理电学部分、劳动技术与信息科技的电子制作模块里,所以 course 不按册次排,
 * 而按**内容块**排:「常见元器件」「识图与装调」「数字逻辑入门」。chapter 是块里的主题,
 * 与 KnowledgePhysicsJunior 一样只用作浏览页的二级分组标题。
 *
 * **与物理表的分工是刻意划开的。** KnowledgePhysicsJunior 那 45 条已经收了电流的形成与方向、
 * 电压的作用、串并联识别与规律、欧姆定律、电功电功率、焦耳定律、家庭电路与安全用电、
 * 电与磁(含电磁感应、电动机与发电机)。这些**电学物理规律**本表一律不重写;本表讲的是
 * **元器件、识图与搭建、数字逻辑、敏感元件** —— 同一只电阻,物理表问它两端电压怎么分,
 * 本表问它的色环怎么读、在图上对应哪只实物、该插在哪两个孔之间。
 *
 * **一条 = 能被单独提问、单独判对错的最小单元**,与 KnowledgePhysicsJunior 同一标准。
 * 上一轮的教训是给条数设上限,代理就把几个各自能单独提问的考点合并去够上限,所以这里
 * 按「宁多勿合并」办:LED 拆成「必须串限流电阻」(kn-ele-jr-008)与「能串几只由电源电压
 * 决定」(009)两条,与/或/非门各一条(028–030),面包板与焊接拆成通孔规则、焊锡原理、
 * 焊点外观判据三条 —— 每一半都能脱离另一半单独判分。
 *
 * **内容边界的诚实说明**:器件参数与工艺事实(硅管导通约 0.7 V、NTC 温度升高阻值下降、
 * 面包板中部 5 孔共用一条簧片、楼梯灯用两只单刀双掷开关)属电工常识与电子制作教具的
 * 通行规格,本身可判对错;而**覆盖面与排列顺序**只是按上述课程块的通行编排整理,
 * **未核对纸质教材目录与劳动技术课程纲要原文**,故整表 `source` 带 `未核实:` 前缀。
 *
 * 前置只引用**本文件内序号更小的 id**(001–033):跨文件引用会被
 * MapValidator.validateKnowledge 判成悬挂引用,两张表各自成链,不做跨表跳转。
 */
const ELE: MapSubject = MapSubject.ELECTRONICS;
const JR: SchoolStage = SchoolStage.JUNIOR;
const COVERAGE: string = UNVERIFIED_PREFIX + '按初中电子制作与劳动技术的通行内容框架编排覆盖面与顺序,未核对教材目录';

function k(id: string, course: string, chapter: string, title: string, statement: string,
  symbols: string[], level: KnowledgeLevel, prereq: string[]): KnowledgePoint {
  return makeKnowledge(id, ELE, JR, course, chapter, title, statement, symbols,
    level, prereq, COVERAGE);
}

