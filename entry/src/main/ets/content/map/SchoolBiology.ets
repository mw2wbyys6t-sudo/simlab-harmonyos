import {
  ExperimentEntry, Feasibility, makeEntry, MapSubject, SchoolStage
} from './CurriculumTypes';

/**
 * 中学生物实验(初中 + 高中)。
 *
 * 这张表补的是地图上的一个真空洞:生物这一行此前只有大学段 41 条,初中与高中两格是 0 ——
 * 而"学校缺实验设备"最常说的恰恰是中学生物的显微镜、装片与解剖。
 *
 * **`RUNNABLE` 一条都没有,`NEEDS_SCENE` 也是一条都没有。**这不是悲观,是接着
 * UniversityBiology 那份判断往下用:现有渲染只有回转体玻璃器皿(量筒/烧杯/试管/漏斗/蒸发皿)、
 * 2D 物理求解(斜面、弹簧振子)与直流电路 MNA 三类,它们承载不了任何一个生物实验的教学目的 ——
 * 生物要读的是视野里的东西、图纸上的空间关系,或者手上做出来的东西。`NEEDS_SCENE` 的定义是
 * "引擎够用、只缺一条场景和它的细则",生物这边没有一条够得上这个前提,所以最少的反而是它。
 * 三档实际判法:
 * - `NEEDS_REAL_GEARS` = 教学目的长在实物与手法上,**做成仿真就是假实验**:对光与调焦、
 *   擦滴撕展盖染、解离与压片、解剖与解剖器械、活体观察与动物行为、野外取样与实物分类、
 *   无菌操作与倒平板接种、发酵与食品。本表 12 条(初中 8、高中 4)。
 * - `NEEDS_RENDERER` = 缺的是画法:显微视野(含测微尺与调焦平面)、组织切片与分期、
 *   三维结构(细胞器、DNA 双螺旋)、菌落与孢子排列、层析色带、计数室视野。共 8 条。
 *   这一档与上一档常常同时成立 —— 一条既要制片又要看视野的,按**第一道坎**记,
 *   如 bio-jr-004 与 bio-jr-010 用的是永久切片与永久涂片(没有制片手法),只剩画法这一坎;
 *   而 bio-sr-008 根尖压片的评分点全在解离与压片上,故记 REAL_GEARS。
 * - `NEEDS_MODEL` = 数据是能算的量,缺的是模型而不是画法:发芽率与条件、燃烧放热与散热、
 *   酶活的温度-pH 曲线、光合与呼吸的气体交换、渗透与质壁分离的定量、浓度—生根响应、
 *   分离比的概率统计、种群增长。共 9 条,也正是最适合仿真的一段。
 *   与 UniversityBiology 的分工一致:形态解剖段一条 MODEL 都没有,那一段的坎不在算而在手。
 *   两处初看像标错的要写明:bio-sr-012(培养液中酵母种群数量)按 RENDERER 记,因为第一道坎是
 *   计数室视野,大学表里同装置也同判;而大学生态段把样方法记成 MODEL,本表的 bio-sr-013
 *   (土壤动物类群丰富度)却记 REAL_GEARS —— 理由是中学这一条的考核点在取样器布设与肉眼分
 *   纲属,计数只是副产品。
 *
 * **出处是 2026-10-09 真读到的两份政府发布页,初中 14 条全部对得上原文项次。**
 * 湖南省教育厅《湖南省初中必做实验目录(2023版)》里"生物学"共 22 条,本表逐条在 source 里
 * 标出所引项次,标题照目录原文用字;教育部《中小学实验教学基本目录》的普通高中生物学共 38 项
 * (跨模块连续编号,不在必修/选必下列),本表 15 条同样标项次,标题照其编排。
 * 但 `principle` / `apparatus` / `dataHandling` 三栏是编写者按该实验的通行做法概括的,
 * 不是从页面上逐字抄的;`term` 与 `minutes` **不在清单里**:册次按人教版教材与该实验在教材中的
 * 位置给、课时按"一课到两课时长"给粗位置,不当作清单信息引用(高中基本目录那 38 项的顺序
 * 与模块大体能对上,但页面上不按册次分栏,故册次仍由本表给)。
 *
 * 有意没写的,分三类说清。
 * 一、同一目的不登记两次:初中那 22 条里「观察种子的结构」「观察根毛和根尖的结构」「观察叶片的
 * 结构」与已列的 bio-jr-006 判由完全相同(实物观察 + 结构标注图,REAL_GEARS),表中只留一条
 * 代表;「观察草履虫」「观察蚯蚓的形态和运动」属活体观察,判由同 bio-jr-011 与 bio-jr-014;
 * 「膝跳反射」是在真人身上完成、结论只有一句话的演示类活动,不列;
 * 「模拟精子与卵细胞的随机结合」的概率统计已由 bio-sr-010 承载(同一目的登记两次没意义)。
 * 二、高中那 38 项里模型制作类还有「制作生物膜结构模型」「制作真核细胞的三维结构模型」
 * 「建立模型模拟减数分裂过程中染色体变化」,判由同 bio-sr-009(缺的是三维结构的画法),本表
 * 只登记 DNA 双螺旋一条 —— 但这一类的存在本身就是三维渲染器要不要开工的依据,不是数据缺失。
 * 其余未列的按两种理由分开对待:
 * (a) 判由与表内条目重合 —— 「观察动物细胞、植物细胞减数分裂装片」与「观察血液分层现象」
 * 同 bio-jr-010(永久材料的显微视野),「DNA 的粗提取与鉴定」「土壤中分解尿素的细菌的分离与
 * 计数」同 bio-sr-014(无菌操作与手法),「利用植物组织培养技术培育植物幼苗」同 bio-sr-014
 * 加数周实物培养,「乳酸菌发酵制作酸奶、泡菜」与腐乳制作同 bio-sr-015(真实食品发酵,
 * 成品要靠尝与看菌膜,仿真给不出),「探究乙烯利对水果的催熟作用」同理;
 * (b) 不该做成仿真或不是学生分组实验 —— 「探究抗生素对细菌的选择作用」需真抑菌圈与选择压力
 * 的长周期培养,「调查草地中某种生物的种群密度」「调查当地环境存在的主要问题并提出保护建议」
 * 「参观人工生态系统」属野外调查与参观实践,教学目的在走出教室与真实数据;
 * 「用数学方法模拟自然选择对种群基因频率的影响」其实可建模,但表里已由 bio-sr-010 承载
 * 同一类"用统计模拟代替真实世代"的条目,不重复登记。
 * 三、两份目录里检索不到同名条目、因此不硬凑出处的:「观察 DNA 与 RNA 在细胞中的分布」
 * (甲基绿—吡罗红)、「体验制备细胞膜的方法」、「血红蛋白的提取和分离(凝胶色谱法)」
 * —— 它们是教材或旧版考纲里的通行项目,但按本表的出处规则要么核到原文要么带 `未核实:` 前缀,
 * 三条又都卡在需要染色判读或色谱柱与分光光度计上,先不进表。
 * **活体、人体材料与安全伦理条目特别标出**,因为这几条的处置要求本身就是评分点,写在
 * `dataHandling` 里而不是当成脚注:涉人体取材的 bio-jr-003(只用消毒牙签碰自己口腔内侧壁、
 * 一次性耗材);涉活体的 bio-jr-011(小鱼离水与强光会加快心率,观察后必须放回)、
 * bio-jr-014(酒精系列对水蚤有致死风险,测完入废液瓶不得放回池塘)、
 * bio-sr-002(全程保湿、以叶绿体是否流动判死活)、bio-sr-011(插条培养两三周,基质与芽数
 * 这些无关变量要一致)、bio-sr-012 与 bio-sr-014(培养液与平板用后灭活);
 * 涉危化与食品的 bio-sr-005(层析液挥发,必须加盖并在通风处)、bio-sr-008(盐酸解离液)、
 * bio-jr-012(平板先灭活再开盖)、bio-sr-015(成品须经教师确认才可尝,杂菌与甲醇不可目测)、
 * bio-sr-013(取土后穴回填、取样器消毒)。
 * 因此一律不进表的:基本目录高中第 17 项「调查一种常见的人类遗传病并探讨其预防措施」——
 * 它取的是他人的遗传信息,做成应用会引出知情同意与去标识化问题,教材本身也只把它排作课外
 * 调查;「饲养家蚕并观察其发育」这类长周期饲养项目(仿真替代不了饲养,而"为仿真而饲养"是
 * 本末倒置);以及「观察鸡卵的结构」—— 它的判由与 bio-jr-006 相同(实物观察 + 结构标注图)。
 * 另要说清一件事:教育部基本目录的初中生物学也有 56 项(按一级主题排,不按年级),本表没有从
 * 那一份里取条目,原因是 56 项里大量是"模拟…""体验…""设计并制作…""调查…"这类演示、
 * 装配与实践条目,不是学生分组实验;而湖南省那份 22 条正是"必做分组实验"的口径,与这张表
 * "按图施工"的用途对得上。两边重合的条目(如显微镜、临时装片、种子萌发、水蚤心率)已在表内。
 */
const BIO: MapSubject = MapSubject.BIOLOGY;
const JR: SchoolStage = SchoolStage.JUNIOR;
const SR: SchoolStage = SchoolStage.SENIOR;
const SRC_JR: string = '湖南省教育厅《湖南省初中必做实验目录(2023版)》湘教发[2023]40号(2023-09-08 印发),初中生物学 22 条 http://jyt.hunan.gov.cn/jyt/sjyt/jyzbc/zbczcwj/syjx/202503/t20250303_33600704.html';
const SRC_SR: string = '教育部《中小学实验教学基本目录》普通高中生物学 38 项(跨模块连续编号),检索自湖南省教育厅转发页 http://jyt.hunan.gov.cn/sjyt/jyzbc/zbczcwj/syjx/202506/t20250605_33692362.html';

function p(id: string, stage: SchoolStage, course: string, term: string, minutes: number,
  title: string, apparatus: string[], principle: string, dataHandling: string,
  knowledge: string[], feasibility: Feasibility, source: string): ExperimentEntry {
  return makeEntry(id, BIO, stage, course, term, minutes, title, apparatus, principle,
    dataHandling, knowledge, feasibility, source);
}

export class SchoolBiology {
  static readonly JUNIOR_COURSE: string = '初中生物实验';
  static readonly SENIOR_COURSE: string = '高中生物实验';

  /** 初中:按人教版七上、七下、八上、八下排,四条册次都要有落点,否则地图上看着像那一册没实验 */
  static junior(): ExperimentEntry[] {
    const out: ExperimentEntry[] = [];
    out.push(p('bio-jr-001', JR, SchoolBiology.JUNIOR_COURSE, '七年级上', 45,
      '练习使用显微镜',
      ['光学显微镜(目镜 5×/10×,物镜 10×/40×)', '永久装片(如植物细胞切片)', '载玻片与盖玻片', '镊子', '擦镜纸', '反光镜或光源'],
      '按取镜安放、对光、放片、低倍镜下降镜筒再上升找物像、换高倍镜并只调细准焦螺旋的顺序做一遍,练习看清并描述一个装片里的结构',
      '写出目镜与物镜倍数并算总放大倍数;在 10× 与 40× 下各数 3 个视野内的细胞数求均值,核对"视野内细胞数与放大倍数的平方成反比"这条关系实测偏离多少;把物像偏出视野、视野发黑、换高倍后一片模糊三种故障各归到装片位置、对光、细准焦螺旋哪一个操作上并写清怎么排除;说明为什么下降镜筒时眼睛要从侧面看着物镜',
      ['显微镜的构造', '对光与调焦', '放大倍数与视野亮度', '倒像与物像移动方向'], Feasibility.NEEDS_REAL_GEARS,
      SRC_JR + ',生物学第 2 项'));
    out.push(p('bio-jr-002', JR, SchoolBiology.JUNIOR_COURSE, '七年级上', 45,
      '制作并观察植物细胞临时装片',
      ['显微镜', '洋葱鳞片叶', '载玻片与盖玻片', '镊子与解剖针', '清水与滴管', '稀碘液', '吸水纸'],
      '擦—滴清水—撕取内表面表皮—展平—盖盖玻片—碘液染色,做出一张没有气泡的洋葱表皮临时装片,在低倍到高倍下认出细胞壁、细胞核与液泡',
      '绘图必画 2~3 个相邻细胞并标出细胞壁、细胞核、液泡与气泡的名称,用铅笔点细点表示明暗而不是涂抹;数并记录本组装片里的气泡个数与染色深浅,与邻座对照,说明盖玻片未一侧先接触液滴、材料未展平各造出什么假象;比较染色前后细胞核看得清不清,交代为什么想看细胞质的流动就不能用碘液杀死细胞',
      ['临时装片制作', '细胞壁与中央液泡', '细胞核的染色', '气泡与杂质的判别'], Feasibility.NEEDS_REAL_GEARS,
      SRC_JR + ',生物学第 3 项'));
    out.push(p('bio-jr-003', JR, SchoolBiology.JUNIOR_COURSE, '七年级上', 40,
      '观察人的口腔上皮细胞',
      ['显微镜', '一次性消毒牙签(钝端)', '质量分数 0.9% 的生理盐水', '稀碘液(或亚甲基蓝)', '载玻片与盖玻片', '吸水纸与滴管', '凉开水(漱口用)'],
      '漱口后用牙签钝端在口腔内侧壁轻刮,把刮取物涂在生理盐水滴中,染色后在高倍下辨认动物细胞的膜、质、核,并与植物细胞并列比较',
      '画一个典型的口腔上皮细胞,与 002 的植物细胞图并列,列表写出两图有/无的结构(细胞壁、液泡、叶绿体、成形细胞核);在 3 个视野内数细胞总数求均值,并记录重叠细胞与食物残渣的剔除标准;说明改用清水代替生理盐水后细胞为什么会胀成圆形甚至破裂,由此反推 0.9% 这个浓度的作用;取材前必须漱口、牙签只能触自己口腔内侧壁这两条卫生要求要写进记录',
      ['动物细胞的基本结构', '生理盐水与细胞形态', '动植物细胞的差异', '视野内计数'], Feasibility.NEEDS_REAL_GEARS,
      SRC_JR + ',生物学第 4 项'));
    out.push(p('bio-jr-004', JR, SchoolBiology.JUNIOR_COURSE, '七年级上', 40,
      '观察人体的基本组织',
      ['显微镜', '人体四种基本组织的永久切片(上皮组织、结缔组织、肌肉组织、神经组织)', '组织图谱', '载物片与盖玻片(破损时更换)', '擦镜纸'],
      '用低倍找到清晰区域再换高倍,观察上皮、结缔、肌肉、神经四种切片,按细胞排列方式、细胞间质多少与有无突起把四类组织区分开',
      '每种组织画一个视野图,标出细胞的排列方向与间质位置;用"细胞排列紧密还是疏松—间质多还是少—有无突起—有无纤维"四项做成判据表,每一格写在这个视野里看到的证据而不是只填类名;记录同一张切片在 10× 与 40× 下判读是否一致,并写出最容易误判的一处(如把血液涂片当成上皮、把肌纤维走向当成结缔纤维);统计每种组织里能数到的细胞个数,说明疏密差异',
      ['细胞分化形成组织', '上皮组织', '结缔组织与血液', '肌肉组织与神经组织'], Feasibility.NEEDS_RENDERER,
      SRC_JR + ',生物学第 5 项'));
    out.push(p('bio-jr-005', JR, SchoolBiology.JUNIOR_COURSE, '七年级上', 45,
      '探究种子萌发的环境条件',
      ['40 粒饱满的绿豆或玉米种子', '4 组培养皿与滤纸', '标签', '清水与冰箱(4 ℃ 组)', '干燥剂或烘干的培养皿(缺水组)', '把种子完全浸没的清水(缺氧组)'],
      '设适宜条件、低温、缺水、缺氧四组,每天记录萌发粒数,只用组与组之间的差别判断种子萌发需要哪些环境条件',
      '每组 10 粒、同条件做 2~3 个重复,在第 3、5、7 天各统计一次发芽率(萌发粒数/供试粒数×100%)并求组内均值,作"日期—发芽率"折线图;逐组写出对照与实验组之间是否只有一个变量不同(缺水组同时也在常温,才能说清是水的作用);用极差而不是统计检验说明重复之间的波动;把"整批不萌发"的假阴性归到种子休眠或胚死亡,并交代如何用一组全部适宜条件的对照把它排除',
      ['种子萌发的环境条件', '对照实验与单一变量', '发芽率的统计', '重复与假阴性'], Feasibility.NEEDS_MODEL,
      SRC_JR + ',生物学第 8 项'));
    out.push(p('bio-jr-006', JR, SchoolBiology.JUNIOR_COURSE, '七年级上', 40,
      '观察花的结构',
      ['完全花的新鲜材料(桃花或海棠花)', '镊子与解剖针', '放大镜', '白纸与胶带', '刀片(横切子房)', '标签'],
      '按花萼—花冠—雄蕊—雌蕊的顺序逐层用镊子摘下并按排列贴在白纸上,再横切子房用放大镜看胚珠,认出一朵完全花的四部分及其着生方式',
      '把拆下的各部分按顺序贴好并注明名称,写清哪部分是花的主要部分及其理由;数每朵花的雄蕊数与心皮数,报本组 3~5 朵的实测值与变动范围,并说明同一物种的雄蕊数是定数还是变数;横切子房数胚珠,再对照一个果实里的种子数,写清两者对不上时的原因(授粉不足、部分胚珠败育);记录材料不新鲜时最容易认错的一处结构',
      ['花的基本结构', '雄蕊与雌蕊', '子房与胚珠', '解剖与标本整理'], Feasibility.NEEDS_REAL_GEARS,
      SRC_JR + ',生物学第 10 项'));
