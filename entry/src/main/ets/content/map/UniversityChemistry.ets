import {
  ExperimentEntry, Feasibility, makeEntry, MapSubject, SchoolStage, UNVERIFIED_PREFIX
} from './CurriculumTypes';

/**
 * 大学化学实验目录:无机及分析化学实验 + 有机化学实验。
 *
 * **这一张表第一轮全部未核实。** 本项目 2026-10-07 试过的两个可核查来源(广西师范大学化学
 * 实验中心的项目页、一份分析化学教学大纲)一个 fetch failed、一个被安全策略拦下,页面正文
 * 没拿到,所以本文件每条 `source` 都以 `UNVERIFIED_PREFIX` 开头、`verified` 一律由 source 推为假。
 * 等 P2 补到具体页面或教材版次后**逐条升级**,不整表翻牌。
 * 表的定位是「按通行教材与多数院校安排整理的施工清单」:项目名与分课可参考,
 * 但**不许把它引用成「某校确实开了这些实验」的证据** —— 出处只保证「这个实验确实开课」,
 * 而这一层保证本文件现在给不出。
 *
 * 与 UniversityPhysics 同样的分工:principle / apparatus / dataHandling 三栏是编写者按该实验
 * 的标准做法概括的,不是从任何清单逐字抄的;term 是按多数院校安排给的粗位置,也不是清单信息。
 *
 * **2026-10-08 把 11 条归属可疑的条目逐条查过一遍(chem-u-005 / 006 / 015 / 016 / 018 / 025 / 031 /
 * 035 / 036 / 056 / 061),它们改的是 `source` 而不是 `title`:** 查到的是讲义题名、课程目录片段与
 * 一份院校实验大纲,够说明「这一项确实存在」或「这一项在别处是两条而不是一条」,但够不上
 * 「本校确实开了这个实验」,所以 11 条全部仍带 `未核实:` 前缀、verified 仍为假,标题一字未动。
 * 查到「某校排两条、某校排一条」这类并存情形时,本表按合并写法保留并在 source 里说明,
 * 因为拆分与合并都是排课决定而不是事实对错。
 *
 * 可行性四档的判据写在这里,否则这栏就成了心情:
 * - RUNNABLE:现有链路能承载 —— 量筒量取与读数视差、溶解-过滤-蒸发(粗盐提纯那条链路)、
 *   实验台的药品柜取用与试管反应现象。只有这三类,一条也不多标。
 * - NEEDS_MODEL:画法够用,缺的是化学计量、终点与平衡模型(多数滴定、重量分析、溶液配制、
 *   反应速率与热效应)。
 * - NEEDS_RENDERER:得先补画法 —— 吸光与标准系列比色、色谱色带与薄层板视野、电泳界面移动、
 *   折光仪临界线与旋光仪明暗视野。
 * - NEEDS_REAL_GEARS:教学目的本身就长在实物上 —— 分析天平称量、滴定管排气泡与半滴控制、
 *   容量瓶定容的弯月面、熔点管与浴液、分馏柱操作、重结晶抽滤、回流与分液漏斗放气。
 *   **这一档在有机那一份里占多数,这是如实判断的结果**:合成与分离实验的评分点在手上,
 *   做成仿真就是假实验,应当明确排除而不是排进工期。另外几处「试纸与颜色判读」同样属这一档,
 *   但它们只是别的实验里的一环,没单独立项,故那几条仍按主导环节标注。
 *
 * 序号 chem-u-039 是刻意留的空:无机及分析占 001–038、有机从 040 起,两号之间留一条界,
 * 免得以后往无机那一份里补项时把编号插到有机段里去 —— 它不代表「删过一个实验」。
 */
const CHEM: MapSubject = MapSubject.CHEMISTRY;
const U: SchoolStage = SchoolStage.UNIVERSITY;
const SRC_INORGANIC: string = UNVERIFIED_PREFIX + '通用无机及分析化学实验教材的通行项目,未核对本校开课清单';
const SRC_ORGANIC: string = UNVERIFIED_PREFIX + '通用有机化学实验教材的通行项目,未核对本校开课清单';

/**
 * 2026-10-08 逐条查过归属的 11 条,`source` 各自写清查到了什么、没查到什么。
 * 这类问题没有对错,只有「某校某教材是否这样排」,所以一律仍留 `未核实:` 前缀(verified 仍为假)、
 * 也不动 title —— 查到的是讲义与大纲片段,不足以上升成「这个实验确实开课」的证据。
 */
const SRC_U005: string = UNVERIFIED_PREFIX + '溶液的配制确为独立项目(检索到《实验一 溶液的配制》讲义,目的写作“掌握几种配制一定浓度溶液的方法和液体、固体试剂的取用方法”,renrendoc paper/299387455;《材料类基础化学实验》亦有实验三 溶剂的配制),但“一般溶液与体积分数溶液”这一合并标题未在任何公开实验目录里取到逐字条目,校际叫法不一,故不改 title、不引成某校清单';
const SRC_U006: string = UNVERIFIED_PREFIX + '未取到把它列为独立实验项目的目录:检索到的一份《分析化学实验》课程目录(renrendoc paper/129977545,14 个项目)在同一位置排的是“滴定分析技能考核”,并无“准确度与精密度评价”条目;多数教材把误差与数据处理写成正文而非实验。本条是按教学目的补的排项,不是清单事实';
const SRC_U015: string = UNVERIFIED_PREFIX + '重量法项目本身有据(讲义通用题名《钡盐中钡含量的测定(沉淀重量法)》,硫酸钡重量法另有标准方法条目 GB/T 15057.8-1994 石灰石中硫含量的测定,标准原文未取到);但灼烧至恒重与称量环节依赖实物,feasibility 只按主导环节记 NEEDS_MODEL,已在 dataHandling 注明';
const SRC_U016: string = UNVERIFIED_PREFIX + '本条是合并写法:检索到的一份《分析化学实验》课程目录把“高锰酸钾溶液的标定”与“过氧化氢含量的测定”列为相邻两个独立项目(第 10、11 项),而另一份讲义合成为一个实验(《实验六 高锰酸钾的标定及过氧化氢含量的测定》,jinchutou p-92222684)。两校排法并存,不能据此认定“合并”是通行安排';
const SRC_U018: string = UNVERIFIED_PREFIX + '本条是合并写法:同一份《分析化学实验》课程目录把“硫代硫酸钠标准溶液的标定”与“胆矾中铜含量的测定”列为第 12、13 两个项目,中国大学MOOC《分析化学实验》(南京中医药大学)亦把“间接碘量法测定铜的含量”单列一章;标定与测铜在多数安排里各占一次课';
const SRC_U025: string = UNVERIFIED_PREFIX + '本条把两种来路并写:pH 计法有独立项目(检索到《大学化学实验》实验八“弱电解质醋酸解离常数的测定”,仪器为数字式酸度计,ubook.reader.qq.com/book-read/25794868/31),电导法另属物理化学实验体系,未取到同一目录把两法并成一个实验或分两次开的条目;先用 pH 试纸粗测那一步属实物判读,未据此改可行性档';
const SRC_U031: string = UNVERIFIED_PREFIX + '分离项目存在(检索到《柱层析法分离甲基橙和亚甲基蓝》《实验二 纸层析,柱色谱》等多份讲义与实验报告标题),但正文均未能抓取:固定相是否碱性氧化铝、洗脱先后与洗脱剂配比都还是按通行做法写的,故“氧化铝吸附柱”这一限定语未证';
const SRC_U035: string = UNVERIFIED_PREFIX + '未取到把它列为“无机及分析化学实验”独立项目的目录:检索到的“水的净化”多在中学实验(人教版九年级 实验 4-1)与环境监测、给水排水课程里,formazin 标准浊度系列则见于国家标准方法条目(GB 13200-91 水质 浊度的测定,只取到条目页、正文未取到)。方法真实,项目归属未证';
const SRC_U036: string = UNVERIFIED_PREFIX + '本条是合并写法:大连理工大学《无机化学实验(二)》(中国大学MOOC 课程页)目录把“p区元素化合物的性质”与“d区元素化合物的性质”列为两个项目,未见“ds区”单独条目;分区怎么并、开几次课各校不一,故 title 里的 p 区与 ds 区合并只是本表的取法';
const SRC_U056: string = UNVERIFIED_PREFIX + '合并写法有据可指:甘肃农业大学《有机化学实验教学大纲》(lixy.gsau.edu.cn/info/1093/4277.htm)实验目录第 6 项即“折光率和旋光度的测定”(4 学时),确作一条;但同一大纲把柱色谱与薄层色谱并进了“菠菜叶色素的分离提纯”,而本表 chem-u-054/055 是分开的两条,故 term 与学时都不从这一份大纲外推';
const SRC_U061: string = UNVERIFIED_PREFIX + '讲义存在但未列为独立项目:检索到《有机化合物的定性鉴别》实验讲义,所用试剂含 2,4-二硝基苯肼、土伦试剂、菲林溶液、碘仿、三氯化铁、溴水等,与本条 apparatus 相符(renrendoc paper/251938489);而甘肃农业大学《有机化学实验教学大纲》的 15 项目录里没有这一条,归属仍属“多数院校安排”层面的判断';

function p(id: string, course: string, term: string, title: string, apparatus: string[],
  principle: string, dataHandling: string, knowledge: string[],
  feasibility: Feasibility, source: string): ExperimentEntry {
  return makeEntry(id, CHEM, U, course, term, 0, title, apparatus, principle,
    dataHandling, knowledge, feasibility, source);
}

