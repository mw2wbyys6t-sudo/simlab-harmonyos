    out.push(k('kn-chem-u-086', KnowledgeChemistry.ORGANIC, '立体异构', '比旋光度、外消旋体与非对映体',
      '手性物质能使平面偏振光的振动面旋转,右旋记 (+)、左旋记 (−),旋光能力用比旋光度 [α] = α/(l·c) 表征(l 以 dm、c 以 g·mL⁻¹ 计,' +
