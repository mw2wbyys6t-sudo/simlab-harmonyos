    out.push(k('kn-chem-u-088', KnowledgeChemistry.ORGANIC, '系统命名法', '含官能团化合物的母体选择与编号',
      '官能团按优先次序排座次(常见次序为羧酸、磺酸、酯、酰卤、酰胺、腈、醛、酮、醇、酚、胺、醚,卤素、硝基与烃基永远只作前缀),' +
