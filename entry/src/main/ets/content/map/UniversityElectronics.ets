import {
  ExperimentEntry, Feasibility, makeEntry, MapSubject, SchoolStage, UNVERIFIED_PREFIX
} from './CurriculumTypes';

/**
 * 电工与电子学实验目录:电工技术、模拟电子技术、数字电子技术三门课里的**实验项目清单**,
 * 不是知识点(知识点在 KnowledgeElectronics,两张表分工不同)。
 *
 * **第一轮全部未核实。**没有拿到任何学校实验中心公布的可核查项目表,所以每条 `source`
 * 都以 `未核实:` 开头,`verified` 由前缀推出为 false。这份清单的覆盖面与顺序来自秦曾煌
 * 《电工学·电工技术》、童诗白与华成英《模拟电子技术基础》、阎石《数字电子技术基础》
 * 三本通用教材配套的通行做法,它能用来排「这门课该做哪些实验」的序,
 * **不能当作某一校的实际开课目录引用**。term 与 minutes 同理,是按多数院校的排法给的粗位置。
 *
 * 可行性怎么判的 —— 判的是引擎能力,不是场景库已经写好了几条:
 * `physics/circuit/CircuitModel.ets` 里的元件集合只有电阻、电位器、灯泡、理想电压源、开关、
 * 电流表、电压表七种;`CircuitRunner` 只用 `MnaSolver` 解一次节点方程(直流、线性、无时间步,
 * `step()` 里只累加时间),观测量到 V/I/SIGNED_I/U/P/Req 为止;`view/SeriesChart` 的横轴
 * 可以换成任一观测量。所以「直流电阻性网络 + 求 U、I、P、Req + 描点画直线」这一类标
 * **NEEDS_SCENE** —— 引擎与画法都够,缺的是一条 CircuitSpec 场景和它的细则,
 * 应用里现有的串联分压、并联分流两个场景就是同一套能力的产物。
 * 注意这一档**不是** RUNNABLE:RUNNABLE 只留给首页真点得开的实验。
 * 目前本表有两条够格 —— `ele-u-003 基尔霍夫定律的验证`(注册表 `kirchhoff`)与
 * `ele-u-007 负载获得最大功率的条件`(注册表 `max-power`,它也是 `RHEOSTAT` 元件第一次被场景用上)。
 * 基尔霍夫那条实现的是 ΣI=0(带参考方向的三条支路电流)与按元件读 ΣU,**没有**并电压表,
 * 所以 dataHandling 里"电压表内阻贡献的误差分量"这一项在应用里读不出来(电流表的 1e-4 Ω 在)。
 * 这条限制写在这里而不是偷偷改掉 dataHandling:那一栏描述的是课程实验该做什么,不跟着应用缩水。
 * 电容、电感、相量、互感、半导体与受控源都不在那七个元件里 → **NEEDS_MODEL**。
 * 说明一点:NEEDS_RENDERER 那批条目其实器件模型也缺,这一档记的是**教学目的卡在哪一层**——
 * 学生要读的若是族曲线、波特图、逻辑电平时序图、七段显示、卡诺图这类新画法,就记在这一档。
 * 目的就在真仪器手感与真实危险上的(示波器探头补偿与触发、面包板虚接排查、焊接、
 * 稳压电源短路过流、家用配电与触电),记 **NEEDS_REAL_GEARS** —— 这些做成仿真就是假实验。
 * 数字电子那一批还有一层共同前提:现有 MNA 只解线性电阻网络,布尔与事件驱动的内核要从零加,
 * 所以本文件里**一条 RUNNABLE 都没有**。
 */
const ELE: MapSubject = MapSubject.ELECTRONICS;
const U: SchoolStage = SchoolStage.UNIVERSITY;
const SRC_CIRCUITS: string = UNVERIFIED_PREFIX + '按秦曾煌《电工学·电工技术》配套实验的通行项目整理,未取到某校公布的项目表';
const SRC_ANALOG: string = UNVERIFIED_PREFIX + '按童诗白、华成英《模拟电子技术基础》配套实验的通行项目整理,未取到某校公布的项目表';
const SRC_DIGITAL: string = UNVERIFIED_PREFIX + '按阎石《数字电子技术基础》配套实验的通行项目整理,未取到某校公布的项目表';

function p(id: string, course: string, term: string, minutes: number, title: string,
  apparatus: string[], principle: string, dataHandling: string, knowledge: string[],
  feasibility: Feasibility, source: string): ExperimentEntry {
  return makeEntry(id, ELE, U, course, term, minutes, title, apparatus, principle,
    dataHandling, knowledge, feasibility, source);
}

