import {
  ExperimentEntry, Feasibility, makeEntry, MapSubject, SchoolStage, UNVERIFIED_PREFIX
} from './CurriculumTypes';

/**
 * 中学化学实验(初中 + 高中)。
 *
 * 这张表补的是化学那一列的两个空格:知识表里初中化学已有 30 条、高中化学 53 条,而实验表这两个
 * 学段一条都没有 —— 于是地图上"这门课该做哪些实验"能答,"其中哪些现在真能打开"只能空着。
 *
 * **`RUNNABLE` 一条都没有,38 条全是"还做不了"。这是刻意的。** 上一版电子表有 8 条因为
 * "求解器够用"就被标成可打开,而应用里根本没有那 8 个实验;昨天刚把这件事钉成断言
 * (RUNNABLE 集合必须等于注册表里真装了的集合)。化学这边同样不许自标:台架引擎
 * `chemistry/BenchEngine` 里确实真装着 11 条桌面反应(见 `ChemistryLibrary.BENCH_IDS`),药品柜
 * 由这 11 条推导,但应用里没有一条"点得开的中学化学实验"可以拿去对注册表 —— 所以凡判
 * "引擎够、只差一条场景和它的细则"的,一律记 `NEEDS_SCENE`,由维护者按台架实测逐条改判。
 * 唯一已经装着的东西是量筒量取(`pages/MeasurePage.ets`,大学表里按 `chem-u-004` 记了 RUNNABLE),
 * 那是大学那侧的账,本表不重复声称,初中的对应条(chem-jr-001)仍记 `NEEDS_SCENE`。
 *
 * 四档在本表的落法(判据照 `Feasibility` 的注释,不是工作量而是做法不同):
 * `NEEDS_SCENE` 11 条 = 台架反应或量取倾倒几何已够 —— 钠与水的"浮熔游响红"、二氧化锰的催化剂
 * 放行、离子方程式与沉淀检验、碳酸氢钠受热分解,这些反应与现象已经在数据表里,改的是场景不是引擎;
 * `NEEDS_MODEL` 16 条 = 缺加热装置与温度、气体收集与验满、溶解热、电离与 pH 定量、滴定体积计量、
 * 质量守恒的称量闭环、电化学;
 * `NEEDS_RENDERER` 2 条 = 缺画法(分子空间结构、晶胞);
 * `NEEDS_REAL_GEARS` 9 条 = 教学目的长在手上功夫与实物观察上 —— 天平称量与游码、容量瓶定容的
 * 弯月面、滴定管的排气泡与半滴控制、焰色与试纸的颜色判读、连接装置的气密性检查、铁钉一周的
 * 锈蚀对照。做成仿真就是假实验,应当明确排除而不是排进工期。
 *
 * **出处只保证「这个实验确实被列为中小学必做/基本实验」这一件事。** 两份都是 2026-10-09 真读到
 * 原文条目名的政府发布页(见下面四个出处常量里的头三个):初中 17 条里有 8 条与湖南省《初中必做
 * 实验目录(2023版)》的化学 8 条同名,**必做那 8 条一条不落**;其余 9 条与高中 21 条取自教育部
 * 《中小学实验教学基本目录》初中化学 35 项、普通高中化学 63 项。`principle` / `apparatus` / `dataHandling` 三栏
 * 是编写者按该实验的通行做法概括的,不是页面逐字抄的;`term` 与 `minutes` **不在清单里**:册次按
 * 人教版(2019)的通行排法、课时按"一课时长"给粗位置。两处以上目录条目被我并成一条时,source 里
 * 写清并进了哪几条;目录的模块归类与教材册次对不上时按教材走 —— 如「探究化学反应的限度」列在
 * 必修而平衡移动列在选择性必修一,本表把两条并成一条并按教材记「选择性必修一」。
 *
 * 只有一条带 `未核实:` 前缀:焰色试验。它是人教版必修一的通行学生实验,但两份目录里都没有同名
 * 条目(最接近的是「溶液中常见离子的检验」,那条考的是沉淀与气体而不是火焰颜色),于是宁可留
 * 未核实也不把教材印象写成目录引用。
 *
 * 有意没写的:①基本目录里的观察与体验类条目(辨别物理变化和化学变化、体验观察物质性质的常用
 * 方法、识别安全警示标志、安全防护设施的使用、观察胶体的丁达尔效应、氨水挥发使酚酞变红、
 * 比较冷水热水中扩散、蜡烛与乙醇燃烧探究元素组成)—— 属演示或认知活动,不是有数据处理要求的
 * 学生分组实验,与 SchoolPhysics 跳过"观察扩散现象"同一口径;②装置与工业流程模拟类(制取蒸馏水、
 * 活性炭与明矾净水、实验室模拟海水提溴提镁、模拟侯氏制碱法)—— 前者要蒸馏装置与相变模型且以
 * 演示为主,后三条是流程设计而不是单次测量;③计算机与手工绘制类(利用计算机作图分析元素性质
 * 参数、自主设计绘制元素周期表、模拟 X 射线衍射)—— 目的在作图与资料处理,不是实验操作;
 * ④食品与药品检验类(补铁剂与抗酸胃药有效成分检验、不同水果中维生素 C 含量比较、常见塑料的
 * 性质与区分、糖类与蛋白质的性质)—— 判分点在实物比色与样品前处理;⑤「探究二氧化碳与氢氧化钠
 * 稀溶液的反应」「探究二氧化碳与水反应」两条并入 chem-jr-005 的性质部分,「常见含氮物质的性质
 * 与转化」「吸氧腐蚀」「制作简单的燃料电池」「探究双液电池」「盐类水解的应用」「简单配合物的
 * 制备」留待高中表扩列 —— 本表按 38 条的规模先守住主干,不是判它们不该做。
 * 两处覆盖上的说明:①初中的「盐的性质与离子检验」没单列成条 —— 初中侧由 005(石灰水检验二氧化
 * 碳)与 009(酸、碱与盐、与碳酸钠的反应)承载,成体系的离子检验流程在 chem-sr-003;②「溶解度与
 * 溶解度曲线」也没单列 —— 教材把它放在活动与图像题里而不是学生实验,012 管溶解过程的吸热放热,
 * 曲线本身作为模型缺口记在 NEEDS_MODEL 那批(溶解度曲线、电离与 pH 定量)的口径里。
 */
const CHEM: MapSubject = MapSubject.CHEMISTRY;
const JR: SchoolStage = SchoolStage.JUNIOR;
const SR: SchoolStage = SchoolStage.SENIOR;
const SRC_JR_MUST: string = '湖南省教育厅《湖南省初中必做实验目录(2023版)》初中化学 8 条(湘教发[2023]40号,2023-09 印发),检索自湖南省教育生产装备处发布页 http://jyt.hunan.gov.cn/jyt/sjyt/jyzbc/zbczcwj/syjx/202503/t20250303_33600704.html';
const SRC_JR_BASIC: string = '教育部《中小学实验教学基本目录》初中化学 35 项,检索自湖南省教育生产装备处转发页 http://jyt.hunan.gov.cn/sjyt/jyzbc/zbczcwj/syjx/202506/t20250605_33692362.html';
const SRC_SR: string = '教育部《中小学实验教学基本目录》普通高中化学 63 项(分必修主题 1-3 与选择性必修模块 1-3),检索自同一转发页 http://jyt.hunan.gov.cn/sjyt/jyzbc/zbczcwj/syjx/202506/t20250605_33692362.html';
const SRC_TAO: string = UNVERIFIED_PREFIX + '人教版高中化学必修一的通行学生实验(教材里挂在金属钠与钾的鉴别活动之下),两份目录均无同名条目,只按教材活动建议与常规做法整理';

function p(id: string, stage: SchoolStage, course: string, term: string, minutes: number,
  title: string, apparatus: string[], principle: string, dataHandling: string,
  knowledge: string[], feasibility: Feasibility, source: string): ExperimentEntry {
  return makeEntry(id, CHEM, stage, course, term, minutes, title, apparatus, principle,
    dataHandling, knowledge, feasibility, source);
}

export class SchoolChemistry {
  static readonly JUNIOR_COURSE: string = '初中化学实验';
  static readonly SENIOR_COURSE: string = '高中化学实验';

  /** 初中:人教版九年级只有一册,故 term 全为「九年级」;其中 8 条与湖南必做目录同名(003、005、006、007、009、011、014、015) */
  static junior(): ExperimentEntry[] {
